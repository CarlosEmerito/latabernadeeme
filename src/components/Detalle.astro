---
import type { Entrada, Edition, Tipo } from "../lib/content";
import { TIPO_META, enlazarConjuros, marcarNiveles, seccionesDe, slugify } from "../lib/content";
import { aliasDe } from "../lib/alias";
import { e } from "../lib/urls";
import Figura from "./Figura.astro";
import Icono from "./Icono.astro";
import { imagenDe } from "../lib/imagenes";

interface Props {
  entrada: Entrada;
  edicion: Edition;
  tipo: Tipo;
  anterior?: Entrada;
  siguiente?: Entrada;
  otraEdicion?: { ed: Edition; srd: string };
}

const { entrada, edicion, tipo, anterior, siguiente, otraEdicion } = Astro.props;
const d = entrada.data;
const html = marcarNiveles(enlazarConjuros(entrada.html, edicion, tipo));
const secciones = seccionesDe(html);
const conIndice = secciones.length >= 4 && entrada.body.length > 4000;
const volver = e(`/${edicion}/${tipo}/`);
const alias = aliasDe(String(d.name));
const imagen = imagenDe(tipo, entrada.slug, String(d.name));
const iconoContexto =
  tipo === "conjuros" && d.school
    ? `escuela-${slugify(String(d.school))}`
    : tipo === "monstruos" && d.type
      ? `tipo-${slugify(String(d.type))}`
      : `seccion-${tipo}`;

const mod = (v: number) => {
  const m = Math.floor((v - 10) / 2);
  return m >= 0 ? `+${m}` : `−${Math.abs(m)}`;
};
const ABREV: Record<string, string> = { fue: "Fue", des: "Des", con: "Con", int: "Int", sab: "Sab", car: "Car" };
const tieneHab = d.abilities && Object.keys(d.abilities).length === 6;

const filasPerfil = [
  ["Tiradas de salvación", d.saves],
  ["Habilidades", d.skills],
  ["Resistencia a daño", d.resistances],
  ["Inmunidad a daño", d.immunities],
  ["Inmunidad a estados", d.conditionImmunities],
  ["Vulnerabilidad a daño", d.vulnerabilities],
  ["Sentidos", d.senses],
  ["Idiomas", d.languages],
  ["Equipo", d.gear],
].filter(([, v]) => v) as [string, string][];

const exportable = {
  tipo,
  edicion,
  srd: edicion === "5e" ? "SRD 5.1" : "SRD 5.2.1",
  datos: d,
  markdown: entrada.body,
};
---

<div class="ficha">
  <article>
    <p class="ficha__banda">
      <Icono nombre={iconoContexto} clase="icono--banda" />
      <b>{TIPO_META[tipo].singular}</b>
      <span aria-hidden="true">·</span>
      <a href={e("/licencias/")} title="Atribución y licencia">
        {edicion === "5e" ? "SRD 5.1" : "SRD 5.2.1"} · p. {d.page}
      </a>
      {tipo === "monstruos" && <><span aria-hidden="true">·</span><span>VD {d.cr}</span></>}
      {tipo === "conjuros" && (
        <>
          <span aria-hidden="true">·</span>
          <span>{d.level === 0 ? "Truco" : `Nivel ${d.level}`} de {d.school}</span>
        </>
      )}
      {tipo === "objetos" && d.rarity && <><span aria-hidden="true">·</span><span>{d.rarity}</span></>}
    </p>

    <h1 class="ficha__titulo">{d.name}</h1>

    <Figura imagen={imagen} />

    {alias && (
      <p class="ficha__alias">
        En inglés: <span lang="en">{alias}</span>
      </p>
    )}

    {tipo === "monstruos" && (
      <section class="perfil" aria-label="Perfil de combate">
        <p class="perfil__tipo">
          {d.size} {String(d.type).toLowerCase()}{d.tags ? ` (${d.tags})` : ""}, {d.alignment}
        </p>

        <dl class="perfil__datos">
          <div><dt>CA</dt><dd>{d.ac}</dd></div>
          <div><dt>PG</dt><dd>{d.hp}</dd></div>
          <div><dt>Velocidad</dt><dd>{d.speed}</dd></div>
          {d.initiative && <div><dt>Iniciativa</dt><dd>{d.initiative}</dd></div>}
        </dl>

        {tieneHab && (
          <dl class="habilidades">
            {(["fue", "des", "con", "int", "sab", "car"] as const).map((k) => (
              <div>
                <dt>{ABREV[k]}</dt>
                <dd>
                  {d.abilities[k]} <span class="mod">{mod(Number(d.abilities[k]))}</span>
                </dd>
              </div>
            ))}
          </dl>
        )}

        <dl class="perfil__datos">
          {filasPerfil.map(([etiqueta, valor]) => (
            <div><dt>{etiqueta}</dt><dd>{valor}</dd></div>
          ))}
          <div>
            <dt>Desafío</dt>
            <dd>{d.cr} ({d.xp}){d.proficiency ? ` · competencia ${d.proficiency}` : ""}</dd>
          </div>
        </dl>
      </section>
    )}

    {tipo === "conjuros" && (
      <dl class="lanzamiento">
        <div><dt>Tiempo</dt><dd>{d.castingTime}</dd></div>
        <div><dt>Alcance</dt><dd>{d.range}</dd></div>
        <div><dt>Componentes</dt><dd>{d.components}</dd></div>
        <div><dt>Duración</dt><dd>{d.duration}</dd></div>
      </dl>
    )}

    <div class="prosa" set:html={html} />
  </article>

  <aside class="aside" aria-label="Datos y navegación">
    {conIndice && (
      <nav class="indice" aria-label="En esta página">
        <h2 class="aside__titulo">En esta página</h2>
        <ol>
          {secciones.map((sec) => (
            <li class:list={[sec.nivel === 3 && "indice__sub"]}>
              <a href={`#${sec.id}`}>{sec.texto}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    {tipo === "conjuros" && Array.isArray(d.classes) && d.classes.length > 0 && (
      <div class="aside__bloque">
        <h2 class="aside__titulo">Listas</h2>
        <p style="margin:0">{d.classes.join(" · ")}</p>
      </div>
    )}

    {tipo === "monstruos" && (
      <div class="aside__bloque">
        <h2 class="aside__titulo">Resumen</h2>
        <dl>
          <dt>VD</dt><dd class="num">{d.cr}</dd>
          <dt>PX</dt><dd class="num">{d.xp}</dd>
          <dt>Tipo</dt><dd>{d.type}</dd>
          <dt>Tamaño</dt><dd>{d.size}</dd>
        </dl>
      </div>
    )}

    {(tipo === "objetos" || tipo === "equipo" || tipo === "clases" || tipo === "dotes") && (
      <div class="aside__bloque">
        <h2 class="aside__titulo">Datos</h2>
        <dl>
          {d.rarity && (<><dt>Rareza</dt><dd>{d.rarity}</dd></>)}
          {d.attunement && (<><dt>Sintonización</dt><dd>Sí</dd></>)}
          {d.price && (<><dt>Precio</dt><dd>{d.price}</dd></>)}
          {d.weight && (<><dt>Peso</dt><dd>{d.weight}</dd></>)}
          {d.category && (<><dt>Categoría</dt><dd>{d.category}</dd></>)}
          {d.hitDie && (<><dt>Dado de golpe</dt><dd>{d.hitDie}</dd></>)}
          {d.primaryAbility && (<><dt>Característica</dt><dd>{d.primaryAbility}</dd></>)}
        </dl>
      </div>
    )}

    {otraEdicion && (
      <div class="aside__bloque">
        <h2 class="aside__titulo">También en</h2>
        <p style="margin:0">
          <a href={e(`/${otraEdicion.ed}/${tipo}/${entrada.slug}/`)}>
            Ver esta entrada en {otraEdicion.srd}
          </a>
          <br />
          <a href={e(`/comparar/${tipo}/${entrada.slug}/`)}>Comparar los dos textos →</a>
        </p>
      </div>
    )}

    <div class="aside__bloque">
      <h2 class="aside__titulo">Fuente</h2>
      <p style="margin:0 0 0.75rem">
        {edicion === "5e" ? "SRD 5.1" : "SRD 5.2.1"} · pág. <span class="num">{d.page}</span><br />
        <span class="muted">CC BY 4.0</span>
      </p>
      <div class="acciones">
        <button class="btn" type="button" id="copiar-md">Copiar Markdown</button>
        <button class="btn" type="button" id="bajar-json">JSON</button>
        <button class="btn" type="button" onclick="window.print()">Imprimir</button>
      </div>
      <p class="acciones__aviso" id="aviso-copia" role="status"></p>
    </div>

    {(anterior || siguiente) && (
      <div class="aside__bloque aside__nav noprint">
        {anterior ? <a href={e(`/${edicion}/${tipo}/${anterior.slug}/`)}>← {anterior.data.name}</a> : <span />}
        {siguiente ? (
          <a href={e(`/${edicion}/${tipo}/${siguiente.slug}/`)} style="text-align:right">{siguiente.data.name} →</a>
        ) : (
          <span />
        )}
      </div>
    )}

    <div class="aside__bloque noprint">
      <a class="btn" href={volver}>← Volver al listado</a>
    </div>
  </aside>
</div>

<script type="application/json" id="datos-entrada" set:html={JSON.stringify(exportable)}></script>
<script>
  const crudo = document.getElementById("datos-entrada")?.textContent;
  if (crudo) {
    const datos = JSON.parse(crudo) as { tipo: string; srd: string; datos: Record<string, any>; markdown: string };
    const aviso = document.getElementById("aviso-copia");
    const decir = (t: string) => {
      if (!aviso) return;
      aviso.textContent = t;
      setTimeout(() => (aviso.textContent = ""), 2200);
    };

    const aMarkdown = () => {
      const d = datos.datos;
      const cabecera = [
        `# ${d.name}`,
        "",
        `*${datos.srd}${d.page ? `, pág. ${d.page}` : ""}*`,
        "",
      ];
      if (datos.tipo === "conjuros") {
        cabecera.push(
          `- **Tiempo:** ${d.castingTime}`,
          `- **Alcance:** ${d.range}`,
          `- **Componentes:** ${d.components}`,
          `- **Duración:** ${d.duration}`,
          "",
        );
      }
      if (datos.tipo === "monstruos") {
        cabecera.push(
          `- **CA:** ${d.ac}`,
          `- **PG:** ${d.hp}`,
          `- **Velocidad:** ${d.speed}`,
          `- **VD:** ${d.cr} (${d.xp} PX)`,
          "",
        );
      }
      cabecera.push(datos.markdown.trim(), "");
      return cabecera.join("\n");
    };

    document.getElementById("copiar-md")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(aMarkdown());
        decir("Copiado al portapapeles.");
      } catch {
        decir("No se pudo copiar. Usa la descarga JSON.");
      }
    });

    document.getElementById("bajar-json")?.addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(datos, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${String(datos.datos.name).toLowerCase().replace(/[^a-z0-9]+/g, "-")}.json`;
      a.click();
      URL.revokeObjectURL(url);
      decir("Descargado.");
    });
  }
</script>
