---
import type { Imagen } from "../lib/imagenes";
import { e } from "../lib/urls";

interface Props {
  imagen: Imagen;
}

const { imagen } = Astro.props;
---

<img
  class="sigilo-entrada"
  src={e(imagen.src)}
  alt={imagen.alt}
  width="120"
  height="120"
  loading="lazy"
  decoding="async"
/>
