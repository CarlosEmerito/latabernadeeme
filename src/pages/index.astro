---
import Base from "../layouts/Base.astro";
import { EDICIONES, TIPOS, TIPO_META, contar, cargar, type Edition, type Tipo } from "../lib/content";
import { e } from "../lib/urls";
import Figura from "../components/Figura.astro";
import { imagenDe } from "../lib/imagenes";

const ediciones = (["5e", "5.5"] as Edition[]).map((ed) => ({
  ed,
  ...EDICIONES[ed],
}));

const COLOR: Record<string, string> = {
  conjuros: "var(--conjuros)",
  monstruos: "var(--monstruos)",
  objetos: "var(--objetos)",
  clases: "var(--clases)",
  especies: "var(--especies)",
  trasfondos: "var(--trasfondos)",
  dotes: "var(--dotes)",
  reglas: "var(--reglas)",
  equipo: "var(--equipo)",
};

/* Los atajos se resuelven contra los datos, no se escriben a mano: un enlace
   fijo se queda viejo en cuanto cambia un nombre o una edición. */
const buscar = (ed: Edition, tipo: Tipo, nombres: string[]) => {
  const entradas = cargar(ed, tipo);
  for (const nombre of nombres) {
    const clave = nombre.toLowerCase();
    const hit = entradas.find(
      (x) => String(x.data.name).toLowerCase() === clave || x.slug === clave,
    );
    if (hit) return { texto: String(hit.data.name), href: e(`/${ed}/${tipo}/${hit.slug}/`) };
  }
  return null;
};

const atajos = [
  buscar("5.5", "conjuros", ["bola de fuego", "bola-de-fuego"]),
  buscar("5.5", "monstruos", ["goblin", "guerrero goblin", "jefe goblin", "secuaz goblin"]),
  buscar("5.5", "clases", ["bárbaro", "barbaro"]),
  buscar("5.5", "equipo", ["cota de malla", "cota-de-malla"]) ??
    buscar("5e", "equipo", ["cota de malla", "cota-de-malla"]),
].filter((x): x is { texto: string; href: string } => x !== null);

const tira = [
  { tipo: "monstruos", slug: "dragon-rojo-adulto", nombre: "Dragón rojo adulto" },
  { tipo: "monstruos", slug: "lobo", nombre: "Lobo" },
  { tipo: "equipo", slug: "espada-larga", nombre: "Espada larga" },
  { tipo: "clases", slug: "mago", nombre: "Mago" },
].map((x) => ({ ...x, imagen: imagenDe(x.tipo, x.slug, x.nombre) }));

const totalConjuros = contar("5e", "conjuros") + contar("5.5", "conjuros");
const totalMonstruos = contar("5e", "monstruos") + contar("5.5", "monstruos");
const totalEntradas = TIPOS.reduce((n, t) => n + contar("5e", t) + contar("5.5", t), 0);
---

<Base
  title="La Taberna de Eme"
  description="Conjuros, monstruos, objetos, clases y reglas de quinta edición (2014) y de las reglas de 2024, en español y con herramientas de mesa."
  ancho
>
  <section class="portada">
    <div>
      <h1 class="portada__titulo">Todo el SRD de <em>D&amp;D 5e y 5.5e</em>, sin ruido.</h1>
      <p class="portada__lede">
        Dos ediciones —<strong>D&amp;D 5e</strong> (2014) y <strong>D&amp;D 5.5e</strong> (2024)—, con{" "}
        {totalConjuros} conjuros, {totalMonstruos} monstruos y el resto del contenido abierto en
        español. Consulta rápida, filtros que no estorban y herramientas de mesa.
      </p>

      <form class="portada__buscar" role="search" aria-label="Buscar en el catálogo" action={e("/buscar/")} method="get">
        <label class="oculto-visual" for="q">Buscar</label>
        <input id="q" type="search" name="q" placeholder="Conjuro, monstruo, objeto, clase…" />
      </form>

      <div class="portada__atajos">
        <span>Ir directo:</span>
        {atajos.map((a) => <a href={a.href}>{a.texto}</a>)}
      </div>
    </div>

    <div class="portada__panel">
      <p class="portada__panel-cab">Explorar · {totalEntradas} entradas</p>
      <ul class="portada__lista">
        {TIPOS.map((t) => {
          const n = contar("5e", t) + contar("5.5", t);
          if (n === 0) return null;
          return (
            <li>
              <a href={e(`/5.5/${t}/`)} style={`--c:${COLOR[t]}`}>
                <span class="punto" aria-hidden="true"></span>
                <span>{TIPO_META[t].plural}</span>
                <span class="num">{n}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="tira" aria-label="Ilustraciones">
    {tira.map((x) => (
      <Figura imagen={x.imagen} variante="tira" />
    ))}
  </section>

  <section class="ediciones" aria-label="Ediciones">
    {ediciones.map((ed) => (
      <a
        class="edicion-carta"
        href={e(`/${ed.ed}/`)}
        style={`--c:${ed.ed === "5e" ? "var(--monstruos)" : "var(--conjuros)"}`}
      >
        <p class="edicion-carta__sello">D&amp;D {ed.ed === "5e" ? "5e" : "5.5e"} · {ed.srd} · {ed.nota}</p>
        <p class="edicion-carta__titulo">
          {ed.ed === "5e" ? "D&D 5e" : "D&D 5.5e"}
        </p>
        <p class="edicion-carta__desc">
          {ed.ed === "5e"
            ? "Las reglas de 2014, con las razas y opciones clásicas que la revisión dejó atrás."
            : "Las reglas de 2024: clases revisadas, maestrías de arma y glosario nuevo."}
        </p>
        <span class="edicion-carta__cifras">
          <span class="edicion-carta__cifra"><b>{contar(ed.ed, "conjuros")}</b><span>conjuros</span></span>
          <span class="edicion-carta__cifra"><b>{contar(ed.ed, "monstruos")}</b><span>monstruos</span></span>
          <span class="edicion-carta__cifra"><b>{contar(ed.ed, "objetos")}</b><span>objetos</span></span>
          <span class="edicion-carta__cifra"><b>{contar(ed.ed, "clases")}</b><span>clases</span></span>
        </span>
      </a>
    ))}
  </section>
</Base>
