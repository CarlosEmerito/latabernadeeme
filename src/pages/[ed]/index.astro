---
import Base from "../../layouts/Base.astro";
import { EDICIONES, TIPOS, TIPO_META, contar, cargar, type Edition } from "../../lib/content";
import { e } from "../../lib/urls";

export function getStaticPaths() {
  return (["5e", "5.5"] as Edition[]).map((ed) => ({ params: { ed } }));
}

const ed = Astro.params.ed as Edition;
const meta = EDICIONES[ed];
const secciones = TIPOS.map((t) => ({ t, n: contar(ed, t) })).filter((x) => x.n > 0);
const total = secciones.reduce((n, s) => n + s.n, 0);
const muestraConjuros = cargar(ed, "conjuros").slice(0, 8);
const muestraMonstruos = cargar(ed, "monstruos").slice(0, 8);
---

<Base title={meta.srd} description={`Todo el contenido del ${meta.srd} en español.`} edicion={ed}>
  <header class="cabecera">
    <div>
      <h1>{meta.srd} · {meta.nota}</h1>
      <p class="cabecera__lede">
        {ed === "5e"
          ? "El documento de referencia de 2014, completo: incluye lo que la revisión dejó fuera, como el semielfo, el semiorco y los planos de existencia."
          : "El documento de referencia de 2024, completo: clases revisadas, maestrías de arma, trasfondos y glosario de reglas."}
      </p>
    </div>
    <div class="cabecera__meta">
      <span><b>{total}</b>entradas</span>
      <span><b>{secciones.length}</b>secciones</span>
    </div>
  </header>

  <table class="tabla tabla--compacta" style="margin-bottom:2.5rem">
    <thead>
      <tr><th scope="col">Sección</th><th scope="col" class="col-num">Entradas</th><th scope="col">Qué hay</th></tr>
    </thead>
    <tbody>
      {secciones.map((s) => (
        <tr>
          <td><a href={e(`/${ed}/${s.t}/`)}>{TIPO_META[s.t].plural}</a></td>
          <td class="col-num">{s.n}</td>
          <td class="col-tenue">{TIPO_META[s.t].desc}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="ediciones-tabla">
    <div class="edicion-bloque">
      <h2>Conjuros</h2>
      <p class="edicion-bloque__nota">Los primeros por orden alfabético</p>
      <ul>
        {muestraConjuros.map((c) => (
          <li>
            <a href={e(`/${ed}/conjuros/${c.slug}/`)}>{c.data.name}</a>
            <span class="num muted">{c.data.level === 0 ? "truco" : `n.º ${c.data.level}`}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="edicion-bloque">
      <h2>Monstruos</h2>
      <p class="edicion-bloque__nota">Los primeros por orden alfabético</p>
      <ul>
        {muestraMonstruos.map((m) => (
          <li>
            <a href={e(`/${ed}/monstruos/${m.slug}/`)}>{m.data.name}</a>
            <span class="num muted">VD {m.data.cr}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
