---
import "../styles/global.css";
import { e } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  edicion?: "5e" | "5.5";
  ruta?: string;
}

const { title, description = "Herramientas y referencia para jugadores y Dungeon Masters de la quinta edición.", edicion, ruta = "" } = Astro.props;
const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/";
const esActiva = (href: string) => (rutaActual === href ? "page" : undefined);
---

<!doctype html>
<html lang="es" data-tema="claro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · La Taberna de Eme</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6efdf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={e("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={e("/manifest.webmanifest")} />
    <meta property="og:title" content={`${title} · La Taberna de Eme`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Tema guardado antes del primer pintado para no parpadear.
      try {
        const guardado = localStorage.getItem("tema");
        const prefiereOscuro = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.tema = guardado || (prefiereOscuro ? "oscuro" : "claro");
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="cabecera__interior">
        <a class="marca" href={e("/")}>
          <span class="marca__emoji" aria-hidden="true">🍺</span>
          <span>La Taberna de Eme</span>
          <span class="marca__sub">D&D 5e</span>
        </a>
        <nav class="cabecera__nav" aria-label="Principal">
          <a class="enlace-nav" href={e("/5e/")} aria-current={esActiva("/5e")}>5e</a>
          <a class="enlace-nav" href={e("/5.5/")} aria-current={esActiva("/5.5")}>5.5</a>
          <a class="enlace-nav" href={e("/mesa/")} aria-current={esActiva("/mesa")}>Mesa</a>
          <a class="enlace-nav" href={e("/buscar/")} aria-current={esActiva("/buscar")}>Buscar</a>
          <button class="boton-icono" id="boton-tema" type="button" aria-label="Cambiar entre tema claro y oscuro">
            <span id="icono-tema" aria-hidden="true">◐</span>
            <span class="visualmente-oculto">Cambiar tema</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="contenido" class:list={["envoltura"]}>
      <slot />
    </main>

    <footer class="pie">
      <div class="pie__interior">
        <div>
          <p>
            Esta obra incluye material procedente del documento de referencia del sistema 5.1
            («SRD 5.1») y del documento de referencia del sistema 5.2.1 («SRD 5.2.1») de Wizards of
            the Coast LLC, disponibles en
            <a href="https://www.dndbeyond.com/srd" rel="noopener">dndbeyond.com/srd</a>.
          </p>
          <p>
            Ambos documentos se distribuyen bajo la licencia internacional de
            atribución/reconocimiento 4.0 de Creative Commons, disponible en
            <a href="https://creativecommons.org/licenses/by/4.0/legalcode.es" rel="noopener">creativecommons.org</a>.
          </p>
        </div>
        <div>
          <p>
            Herramienta no oficial, sin afiliación ni respaldo de Wizards of the Coast. Las marcas
            de Dungeons &amp; Dragons pertenecen a sus titulares; aquí solo se usa el contenido
            abierto del SRD.
          </p>
          <p>
            <a href={e("/licencias/")}>Licencias y fuentes</a> · <a href={e("/accesibilidad/")}>Accesibilidad</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const boton = document.getElementById("boton-tema");
      const icono = document.getElementById("icono-tema");
      const pintarIcono = () => {
        const oscuro = document.documentElement.dataset.tema === "oscuro";
        icono.textContent = oscuro ? "☀" : "☾";
        boton?.setAttribute("aria-pressed", String(oscuro));
      };
      pintarIcono();
      boton?.addEventListener("click", () => {
        const oscuro = document.documentElement.dataset.tema === "oscuro";
        document.documentElement.dataset.tema = oscuro ? "claro" : "oscuro";
        try {
          localStorage.setItem("tema", document.documentElement.dataset.tema);
        } catch (e) {}
        pintarIcono();
      });
    </script>
  </body>
</html>
