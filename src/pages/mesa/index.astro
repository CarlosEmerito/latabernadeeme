---
import Base from "../../layouts/Base.astro";
import { cargar } from "../../lib/content";

const objetos51 = cargar("5e", "objetos");
const porRareza: Record<string, string[]> = {};
for (const o of objetos51) {
  const r = String(o.data.rarity || "sin rareza").toLowerCase();
  (porRareza[r] ??= []).push(String(o.data.name));
}
---

<Base
  title="Mesa"
  description="Generador de encuentros, iniciativa, dados, PNJ y botín para tus partidas."
  ancho
>
  <header class="cabecera">
    <div>
      <h1>Mesa</h1>
      <p class="cabecera__lede">Cuatro cosas que se usan en mitad de una sesión, sin cuentas ni esperas.</p>
    </div>
  </header>

  <div class="mesa-grid">
    <section class="mesa-panel" aria-labelledby="p-encuentros">
      <h2 id="p-encuentros">Encuentros</h2>
      <fieldset>
        <label>Personajes <input type="number" id="enc-pj" min="1" max="10" value="4" /></label>
        <label>Nivel <input type="number" id="enc-nivel" min="1" max="20" value="3" /></label>
        <label>Dificultad
          <select id="enc-dif" aria-label="Dificultad del encuentro">
            <option value="facil">Fácil</option>
            <option value="media" selected>Media</option>
            <option value="dificil">Difícil</option>
            <option value="mortal">Mortal</option>
          </select>
        </label>
      </fieldset>
      <button class="btn btn--acento" type="button" id="enc-calcular">Calcular presupuesto</button>
      <p class="salida" id="enc-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-iniciativa">
      <h2 id="p-iniciativa">Iniciativa</h2>
      <fieldset>
        <label>Nombre <input type="text" id="ini-nombre" placeholder="Goblin 1" /></label>
        <label>Valor <input type="number" id="ini-valor" value="10" /></label>
      </fieldset>
      <button class="btn" type="button" id="ini-anadir">Añadir</button>
      <button class="btn btn--fantasma" type="button" id="ini-siguiente">Siguiente turno</button>
      <ol id="ini-lista" class="salida" aria-live="polite"></ol>
    </section>

    <section class="mesa-panel" aria-labelledby="p-dados">
      <h2 id="p-dados">Dados</h2>
      <fieldset>
        <label>Tirada <input type="text" id="dad-expresion" value="1d20+5" /></label>
        <label>Ventaja <input type="checkbox" id="dad-ventaja" /></label>
      </fieldset>
      <button class="btn btn--acento" type="button" id="dad-tirar">Tirar</button>
      <p class="salida" id="dad-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-pnj">
      <h2 id="p-pnj">PNJ de improviso</h2>
      <button class="btn btn--acento" type="button" id="pnj-generar">Generar</button>
      <p class="salida" id="pnj-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-botin">
      <h2 id="p-botin">Botín</h2>
      <fieldset>
        <label>Rareza
          <select id="bot-rareza" aria-label="Rareza del objeto mágico">
            <option value="común">Común</option>
            <option value="poco común" selected>Poco común</option>
            <option value="raro">Raro</option>
            <option value="muy raro">Muy raro</option>
            <option value="legendario">Legendario</option>
          </select>
        </label>
      </fieldset>
      <button class="btn btn--acento" type="button" id="bot-generar">Generar botín</button>
      <p class="salida" id="bot-salida" aria-live="polite"></p>
    </section>
  </div>

  <script id="datos-botin" type="application/json" set:html={JSON.stringify(porRareza)}></script>

  <script>
    const UMBRALES: Record<number, [number, number, number, number]> = {
      1: [25, 50, 75, 100], 2: [50, 100, 150, 200], 3: [75, 150, 225, 400], 4: [125, 250, 375, 500],
      5: [250, 500, 750, 1100], 6: [300, 600, 900, 1400], 7: [350, 750, 1100, 1700], 8: [450, 900, 1400, 2100],
      9: [550, 1100, 1600, 2400], 10: [600, 1200, 1900, 2800], 11: [800, 1600, 2400, 3600], 12: [1000, 2000, 3000, 4500],
      13: [1100, 2200, 3400, 5100], 14: [1250, 2500, 3800, 5700], 15: [1400, 2800, 4300, 6400], 16: [1600, 3200, 4800, 7200],
      17: [2000, 3900, 5900, 8800], 18: [2100, 4200, 6300, 9500], 19: [2400, 4900, 7300, 10900], 20: [2800, 5700, 8500, 12700],
    };
    const IDX: Record<string, number> = { facil: 0, media: 1, dificil: 2, mortal: 3 };

    document.getElementById("enc-calcular")?.addEventListener("click", () => {
      const pj = Number((document.getElementById("enc-pj") as HTMLInputElement).value);
      const nivel = Math.min(20, Math.max(1, Number((document.getElementById("enc-nivel") as HTMLInputElement).value)));
      const dif = (document.getElementById("enc-dif") as HTMLSelectElement).value;
      const total = UMBRALES[nivel][IDX[dif]] * pj;
      document.getElementById("enc-salida")!.innerHTML =
        `<strong>${total.toLocaleString("es-ES")} PX</strong> para ${pj} personajes de nivel ${nivel}. ` +
        `${Math.floor(total / 50)} criaturas de 50 PX o ${Math.floor(total / 200)} de 200 PX. ` +
        `<span class="muted">Orientativo.</span>`;
    });

    type C = { nombre: string; valor: number };
    let combatientes: C[] = [];
    let turno = 0;
    const pintarIniciativa = () => {
      const lista = document.getElementById("ini-lista")!;
      lista.innerHTML = [...combatientes]
        .sort((a, b) => b.valor - a.valor)
        .map((c, i) => `<li${i === turno ? ' style="font-weight:700;color:var(--accent)"' : ""}>${c.nombre} — ${c.valor}</li>`)
        .join("");
    };
    document.getElementById("ini-anadir")?.addEventListener("click", () => {
      const nombre = (document.getElementById("ini-nombre") as HTMLInputElement).value.trim() || "Sin nombre";
      const valor = Number((document.getElementById("ini-valor") as HTMLInputElement).value) || 0;
      combatientes.push({ nombre, valor });
      (document.getElementById("ini-nombre") as HTMLInputElement).value = "";
      pintarIniciativa();
    });
    document.getElementById("ini-siguiente")?.addEventListener("click", () => {
      if (!combatientes.length) return;
      combatientes.sort((a, b) => b.valor - a.valor);
      turno = (turno + 1) % combatientes.length;
      pintarIniciativa();
    });

    const d = (caras: number) => Math.floor(Math.random() * caras) + 1;
    document.getElementById("dad-tirar")?.addEventListener("click", () => {
      const entrada = (document.getElementById("dad-expresion") as HTMLInputElement).value.replace(/\s/g, "");
      const m = /^(\d*)d(\d+)([+-]\d+)?$/i.exec(entrada);
      const salida = document.getElementById("dad-salida")!;
      if (!m) return void (salida.textContent = "Formato: 2d6+3");
      const n = Number(m[1] || 1), caras = Number(m[2]), mod = Number(m[3] || 0);
      if (n > 100 || caras > 1000) return void (salida.textContent = "Demasiados dados.");
      const tiradas = Array.from({ length: n }, () => d(caras));
      let total = tiradas.reduce((a, b) => a + b, 0) + mod;
      let extra = "";
      if ((document.getElementById("dad-ventaja") as HTMLInputElement).checked && n === 1 && caras === 20) {
        const otra = d(20);
        total = Math.max(tiradas[0], otra) + mod;
        extra = ` (la otra: ${Math.min(tiradas[0], otra)})`;
      }
      salida.innerHTML = `<strong>${total}</strong> = [${tiradas.join(", ")}]${mod ? ` ${mod > 0 ? "+" : "−"} ${Math.abs(mod)}` : ""}${extra}`;
    });

    const NOMBRES = ["Aldara", "Brumo", "Cassia", "Doran", "Elva", "Fermín", "Greta", "Hugo", "Isolda", "Jaro", "Kelia", "Lupo", "Mara", "Néstor", "Olga", "Pietro", "Quina", "Ramiro", "Sela", "Tobías", "Úrsula", "Vasco", "Wenda", "Ximena", "Yago", "Zoe"];
    const OFICIOS = ["herrero", "tabernero", "curandera", "guardia", "cartógrafo", "contrabandista", "escribano", "cazador", "barquero", "sepulturero", "juglar", "boticaria", "armero", "molinero", "sastre", "lacayo"];
    const MANIAS = ["no mira a los ojos cuando miente", "habla siempre en susurros", "cobra por adelantado y sin excepciones", "tiene un cuervo que repite lo que oye", "desconfía de cualquiera con espada", "recuerda todas las deudas, hasta las de cobre", "se ríe en el momento menos oportuno", "lleva guantes incluso en verano", "jura que vio algo en el bosque", "no bebe nada que no sirva él mismo"];
    const azar = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
    document.getElementById("pnj-generar")?.addEventListener("click", () => {
      document.getElementById("pnj-salida")!.innerHTML = `<strong>${azar(NOMBRES)}</strong>, ${azar(OFICIOS)}. Se rumorea que ${azar(MANIAS)}.`;
    });

    document.getElementById("bot-generar")?.addEventListener("click", () => {
      const datos: Record<string, string[]> = JSON.parse(document.getElementById("datos-botin")!.textContent || "{}");
      const rareza = (document.getElementById("bot-rareza") as HTMLSelectElement).value;
      const lista = datos[rareza] || [];
      document.getElementById("bot-salida")!.innerHTML =
        `<strong>${Math.floor(Math.random() * 20) + 1} po</strong> y <strong>${Math.floor(Math.random() * 100) + 1} pp</strong>; además, <em>${lista.length ? azar(lista) : "un objeto sin identificar"}</em>.`;
    });
  </script>
</Base>
