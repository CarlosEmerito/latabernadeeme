---
import Base from "../../../layouts/Base.astro";
import Lateral from "../../../components/Lateral.astro";
import Listado from "../../../components/Listado.astro";
import { EDICIONES, TIPO_META, cargar, type Edition, type Tipo, TIPOS } from "../../../lib/content";
import { preparar } from "../../../lib/facetas";
import { e } from "../../../lib/urls";

export function getStaticPaths() {
  const rutas: { params: { ed: string; tipo: string } }[] = [];
  for (const ed of ["5e", "5.5"] as Edition[]) {
    for (const tipo of TIPOS) {
      rutas.push({ params: { ed, tipo } });
    }
  }
  return rutas;
}

const ed = Astro.params.ed as Edition;
const tipo = Astro.params.tipo as Tipo;
const meta = EDICIONES[ed];
const entradas = cargar(ed, tipo);
const { facetas, items } = preparar(tipo, entradas);
const t = TIPO_META[tipo];
---

<Base title={`${t.plural} · ${meta.srd}`} description={`${entradas.length} ${t.plural.toLowerCase()} del ${meta.srd} en español.`}>
  <div class="con-lateral">
    <Lateral edicion={ed} actual={tipo} />
    <div>
      <p class="ceja">{meta.srd} · {meta.nota}</p>
      <div class="titulo-pagina">
        <h1>{t.plural}</h1>
        <span class="badge">{entradas.length}</span>
      </div>
      <p class="entradilla">{t.desc} del documento de referencia en español. Filtra por lo que necesites; todo el texto es el original.</p>

      {entradas.length === 0 ? (
        <p class="panel">Todavía no hay contenido de este tipo en esta edición.</p>
      ) : (
        <Listado base={e(`/${ed}/${tipo}`)} items={items} facetas={facetas} />
      )}
    </div>
  </div>
</Base>
