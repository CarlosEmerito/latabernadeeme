---
import Base from "../../layouts/Base.astro";
import Lateral from "../../components/Lateral.astro";
import { EDICIONES, TIPOS, TIPO_META, cargar, contar, type Edition } from "../../lib/content";
import { e } from "../../lib/urls";

export function getStaticPaths() {
  return (["5e", "5.5"] as Edition[]).map((ed) => ({ params: { ed } }));
}

const ed = Astro.params.ed as Edition;
const meta = EDICIONES[ed];
const tipos = TIPOS.filter((t) => contar(ed, t) > 0);

const destacados = {
  conjuros: cargar(ed, "conjuros").slice(0, 6),
  monstruos: cargar(ed, "monstruos").slice(0, 6),
};
---

<Base title={meta.titulo} description={`Todo el contenido del ${meta.srd}: ${tipos.map((t) => TIPO_META[t].plural.toLowerCase()).join(", ")}.`}>
  <div class="con-lateral">
    <Lateral edicion={ed} />
    <div>
      <p class="ceja">{meta.srd} · {meta.nota}</p>
      <h1>{meta.titulo}</h1>
      <p class="entradilla">
        {ed === "5e"
          ? "El documento de referencia de 2014 en español, completo: conjuros, monstruos, objetos, clases, razas y reglas. Incluye lo que la revisión dejó fuera, como el semielfo, el semiorco y los planos de existencia."
          : "El documento de referencia de 2024 en español, completo: conjuros, monstruos, objetos, clases, especies, trasfondos y el glosario de reglas revisado."}
      </p>

      <div class="rejilla" style="margin-bottom:2.5rem">
        {tipos.map((t) => (
          <a class="tarjeta" href={e(`/${ed}/${t}/`)}>
            <span class="tarjeta__nombre">
              <span aria-hidden="true">{TIPO_META[t].icono}</span> {TIPO_META[t].plural}
            </span>
            <span class="tarjeta__meta">{contar(ed, t)} entradas</span>
            <span class="tarjeta__texto">{TIPO_META[t].desc}</span>
          </a>
        ))}
      </div>

      {destacados.conjuros.length > 0 && (
        <section aria-labelledby="conjuros-destacados">
          <h2 id="conjuros-destacados">Conjuros</h2>
          <ul class="lista-limpia" style="columns:2;column-gap:2rem">
            {destacados.conjuros.map((c) => (
              <li style="break-inside:avoid;margin-bottom:.35rem">
                <a href={e(`/${ed}/conjuros/${c.slug}/`)}>{c.data.name}</a>{" "}
                <span style="font-family:var(--fuente-ui);font-size:.78rem;color:var(--tinta-tenue)">
                  {c.data.level === 0 ? "truco" : `nivel ${c.data.level}`}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {destacados.monstruos.length > 0 && (
        <section aria-labelledby="monstruos-destacados" style="margin-top:2rem">
          <h2 id="monstruos-destacados">Monstruos</h2>
          <ul class="lista-limpia" style="columns:2;column-gap:2rem">
            {destacados.monstruos.map((m) => (
              <li style="break-inside:avoid;margin-bottom:.35rem">
                <a href={e(`/${ed}/monstruos/${m.slug}/`)}>{m.data.name}</a>{" "}
                <span style="font-family:var(--fuente-ui);font-size:.78rem;color:var(--tinta-tenue)">
                  VD {m.data.cr}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>
