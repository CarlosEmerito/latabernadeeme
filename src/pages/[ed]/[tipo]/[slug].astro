---
import Base from "../../../layouts/Base.astro";
import Detalle from "../../../components/Detalle.astro";
import { EDICIONES, TIPO_META, cargar, type Edition, type Tipo, TIPOS } from "../../../lib/content";
import { e } from "../../../lib/urls";
import { imagenDe } from "../../../lib/imagenes";

export function getStaticPaths() {
  const rutas: { params: { ed: string; tipo: string; slug: string } }[] = [];
  for (const ed of ["5e", "5.5"] as Edition[]) {
    for (const tipo of TIPOS) {
      for (const en of cargar(ed, tipo)) rutas.push({ params: { ed, tipo, slug: en.slug } });
    }
  }
  return rutas;
}

const ed = Astro.params.ed as Edition;
const tipo = Astro.params.tipo as Tipo;
const slug = Astro.params.slug!;
const entradas = cargar(ed, tipo);
const indice = entradas.findIndex((x) => x.slug === slug);
const entrada = entradas[indice];

if (!entrada) return Astro.redirect(e("/404/"));

const otra: Edition = ed === "5e" ? "5.5" : "5e";
const existeEnOtra = cargar(otra, tipo).some((x) => x.slug === slug);
const otraEdicion = existeEnOtra ? { ed: otra, srd: EDICIONES[otra].srd } : undefined;

const meta = EDICIONES[ed];
const t = TIPO_META[tipo];
const titulo = String(entrada.data.name);
const descripcion =
  tipo === "monstruos"
    ? `${titulo}, VD ${entrada.data.cr} (${meta.srd}).`
    : tipo === "conjuros"
      ? `${titulo}, ${entrada.data.level === 0 ? "truco" : `conjuro de nivel ${entrada.data.level}`} de ${entrada.data.school} (${meta.srd}).`
      : `${titulo} (${meta.srd}).`;
const sigilo = imagenDe(tipo, slug, titulo).src;
---

<Base title={titulo} description={descripcion} edicion={ed} tipo={tipo} imagen={sigilo} tipoOg="article">
  <nav class="migas" aria-label="Migas de pan">
    <a href={e(`/${ed}/`)}>{meta.srd}</a>
    <span aria-hidden="true">/</span>
    <a href={e(`/${ed}/${tipo}/`)}>{t.plural}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{titulo}</span>
  </nav>

  <Detalle
    entrada={entrada}
    edicion={ed}
    tipo={tipo}
    anterior={indice > 0 ? entradas[indice - 1] : undefined}
    siguiente={indice < entradas.length - 1 ? entradas[indice + 1] : undefined}
    otraEdicion={otraEdicion}
  />
</Base>
