---
import Base from "../../layouts/Base.astro";
import { e } from "../../lib/urls";
---

<Base title="Buscar" description="Busca en conjuros, monstruos, objetos, clases y reglas de las dos ediciones." ancho>
  <header class="cabecera">
    <div>
      <h1>Buscar</h1>
      <p class="cabecera__lede">Índice completo del contenido de las dos ediciones.</p>
    </div>
  </header>

  <div id="busqueda"></div>

  <noscript>
    <p class="muted">El buscador necesita JavaScript. Los listados de cada sección sí funcionan sin él.</p>
  </noscript>

  <link rel="stylesheet" href={e("/pagefind/pagefind-ui.css")} />
  <script is:inline src={e("/pagefind/pagefind-ui.js")}></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.PagefindUI === "undefined") return;
      // Los formularios de la cabecera y de la portada envían GET ?q=… hasta aquí;
      // Pagefind no lee la dirección por su cuenta, así que se le pasa el término.
      const termino = (new URLSearchParams(window.location.search).get("q") ?? "").trim();
      const ui = new window.PagefindUI({
        element: "#busqueda",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: "Bola de fuego, goblin, cota de malla…",
          clear_search: "Limpiar",
          load_more: "Ver más",
          search_label: "Buscar en La Taberna de Eme",
          zero_results: "Sin resultados para [SEARCH_TERM]",
          many_results: "[COUNT] resultados para [SEARCH_TERM]",
          one_result: "1 resultado para [SEARCH_TERM]",
          alt_search: "Sin resultados para [SEARCH_TERM]. Mostrando [DIFFERENT_TERM]",
          search_suggestion: "Prueba con otra palabra",
          searching: "Buscando [SEARCH_TERM]…",
        },
      });
      if (termino) ui.triggerSearch(termino);
    });
  </script>
</Base>
