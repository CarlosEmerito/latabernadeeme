---
import Base from "../../layouts/Base.astro";
import MesaNav from "../../components/MesaNav.astro";
import { cargar, EDICIONES } from "../../lib/content";
import { e } from "../../lib/urls";
import { REGLAS, dificultadPorDefecto, dificultadesDe } from "../../lib/presupuesto";

// El botín sale del catálogo que la página declara: el 5.2.1, el mismo con el
// que arranca el constructor de encuentros. Leerlo del 5.1 dejaba fuera 24
// objetos de 2024 —seis legendarios, «Capa de invisibilidad» entre ellos— y
// dejaba la rareza «Común» con un solo objeto, así que el generador devolvía
// siempre el mismo y parecía roto.
const CATALOGO_BOTIN = "5.5" as const;
const srdBotin = EDICIONES[CATALOGO_BOTIN];
const objetosBotin = cargar(CATALOGO_BOTIN, "objetos");
const porRareza: Record<string, string[]> = {};
for (const o of objetosBotin) {
  const r = String(o.data.rarity || "sin rareza").toLowerCase();
  (porRareza[r] ??= []).push(String(o.data.name));
}
// Ordenados por nombre para que el JSON publicado sea estable entre compilaciones.
for (const lista of Object.values(porRareza)) lista.sort((a, b) => a.localeCompare(b, "es"));

// El panel arranca con el catálogo 5.2.1, así que las dificultades que se
// publican en el HTML son las suyas. El script las rehace al cambiar de
// catálogo; estas son las que ve quien lee la página sin ejecutar nada.
const catalogoInicial = "5.5";
const reglaInicial = REGLAS[catalogoInicial];
const dificultadesIniciales = dificultadesDe(catalogoInicial);
const dificultadInicial = dificultadPorDefecto(catalogoInicial);
---

<Base title="Mesa" description="Constructor de encuentros, iniciativa, dados, PNJ y botín para tus partidas." ancho>
  <header class="cabecera">
    <div>
      <h1>Mesa</h1>
      <p class="cabecera__lede">
        Herramientas para el minuto exacto en que la partida se atasca. Nada se guarda en ningún
        servidor: todo vive en tu navegador.
      </p>
    </div>
  </header>

  <MesaNav />

  <div class="mesa-grid">
    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-pantalla">
      <h2 id="p-pantalla">Pantalla del DM</h2>
      <p class="mesa-panel__nota">
        Condiciones, acciones, exploración y peligros en una sola pantalla. Elige qué paneles
        quieres, la elección se recuerda en este navegador y se imprime tal cual para tenerla
        delante en la partida.
      </p>
      <a class="btn btn--acento" href={e("/mesa/pantalla/")}>Abrir la pantalla del DM</a>
    </section>

    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-encuentros">
      <h2 id="p-encuentros">Encuentros</h2>
      <p class="mesa-panel__nota" id="enc-regla">
        Presupuesto de PX de {reglaInicial.titulo}. {reglaInicial.nota}
      </p>

      <div class="mesa-fila">
        <label>Catálogo
          <select id="enc-ed">
            <option value="5.5" selected>5.2.1 (2024)</option>
            <option value="5e">5.1 (2014)</option>
          </select>
        </label>
        <label>Personajes <input type="number" id="enc-pj" min="1" max="10" value="4" /></label>
        <label>Nivel <input type="number" id="enc-nivel" min="1" max="20" value="3" /></label>
        <label>Dificultad
          <select id="enc-dif" aria-label="Dificultad del encuentro">
            {dificultadesIniciales.map((d) => (
              <option value={d.clave} selected={d.clave === dificultadInicial.clave}>{d.etiqueta}</option>
            ))}
          </select>
        </label>
      </div>

      <label class="mesa-buscador">
        <span>Añadir criatura</span>
        <input type="search" id="enc-buscar" list="enc-lista" placeholder="Goblin, lobo, dragón rojo…" autocomplete="off" aria-describedby="enc-aviso" />
        <datalist id="enc-lista"></datalist>
      </label>
      <p class="mesa-aviso" id="enc-aviso" role="status" hidden></p>
      <button class="btn btn--fantasma" type="button" id="enc-reintentar" hidden>Reintentar la carga del catálogo</button>

      <ul id="enc-anadidas" class="mesa-anadidas" aria-live="polite"></ul>

      <div class="mesa-resumen" id="enc-salida" aria-live="polite"></div>
      <button class="btn btn--fantasma" type="button" id="enc-vaciar">Vaciar</button>
    </section>


    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-ajustar">
      <h2 id="p-ajustar">Ajustar una criatura</h2>
      <p class="mesa-panel__nota">
        Sube o baja el valor de desafío de una criatura del catálogo tomando como referencia la media
        de PG y CA de las criaturas de ese VD. Es una aproximación de mesa, no una regla del manual.
        El VD objetivo se escribe tal cual lo publica el catálogo, fraccionarios incluidos
        (<code>1/8</code>, <code>1/4</code>, <code>1/2</code>) o en decimal (<code>0.125</code>,
        <code>0.25</code>, <code>0.5</code>).
      </p>
      <div class="mesa-fila">
        <label class="mesa-ancho">Criatura
          <input type="search" id="aj-criatura" list="enc-lista" placeholder="Guerrero goblin, trol, aboleth…" autocomplete="off" />
        </label>
        <label>VD actual <output id="aj-vd">—</output></label>
        <label>VD objetivo <input type="text" inputmode="decimal" id="aj-objetivo" value="5" /></label>
        <button class="btn btn--acento" type="button" id="aj-calcular">Ajustar</button>
      </div>
      <div id="aj-salida" class="mesa-resumen" aria-live="polite">
        <p class="muted">Elige una criatura y un VD objetivo.</p>
      </div>
    </section>

    <section class="mesa-panel" aria-labelledby="p-vd">
      <h2 id="p-vd">Estimar VD</h2>
      <p class="mesa-panel__nota">Para una criatura propia: con su PG y su CA busco sus vecinas. Si no sabes la CA, se estima solo por PG.</p>
      <div class="mesa-fila">
        <label>PG <input type="number" id="vd-pg" min="1" value="45" /></label>
        <label>CA <input type="number" id="vd-ca" min="1" value="15" /></label>
      </div>
      <button class="btn btn--acento" type="button" id="vd-estimar">Estimar</button>
      <p class="salida" id="vd-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-iniciativa">
      <h2 id="p-iniciativa">Iniciativa</h2>
      <div class="mesa-fila">
        <label>Nombre <input type="text" id="ini-nombre" placeholder="Goblin 1" /></label>
        <label>Valor <input type="number" id="ini-valor" value="10" /></label>
      </div>
      <div class="mesa-botones">
        <button class="btn" type="button" id="ini-anadir">Añadir</button>
        <button class="btn btn--acento" type="button" id="ini-siguiente">Siguiente turno</button>
        <button class="btn btn--fantasma" type="button" id="ini-vaciar">Vaciar combate</button>
      </div>
      <ol id="ini-lista" class="mesa-iniciativa" aria-live="polite"></ol>
      <button class="btn btn--fantasma" type="button" id="ini-proyectar">Abrir vista de jugador</button>
    </section>

    <section class="mesa-panel" aria-labelledby="p-dados">
      <h2 id="p-dados">Dados</h2>
      <div class="mesa-fila">
        <label>Tirada <input type="text" id="dad-expresion" value="1d20+5" /></label>
        <label class="mesa-check">Ventaja <input type="checkbox" id="dad-ventaja" /></label>
      </div>
      <button class="btn btn--acento" type="button" id="dad-tirar">Tirar</button>
      <p class="salida" id="dad-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-pnj">
      <h2 id="p-pnj">PNJ de improviso</h2>
      <button class="btn btn--acento" type="button" id="pnj-generar">Generar</button>
      <p class="salida" id="pnj-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-botin">
      <h2 id="p-botin">Botín</h2>
      <p class="mesa-panel__nota" id="bot-regla">
        Objetos mágicos del catálogo {srdBotin.srd} ({srdBotin.nota}), el mismo con el que arranca el
        resto de la sección Mesa: {objetosBotin.length} objetos repartidos por rareza.
      </p>
      <div class="mesa-fila">
        <label>Rareza
          <select id="bot-rareza" aria-label="Rareza del objeto mágico">
            <option value="común">Común</option>
            <option value="poco común" selected>Poco común</option>
            <option value="raro">Raro</option>
            <option value="muy raro">Muy raro</option>
            <option value="legendario">Legendario</option>
          </select>
        </label>
      </div>
      <button class="btn btn--acento" type="button" id="bot-generar">Generar botín</button>
      <p class="salida" id="bot-salida" aria-live="polite"></p>
    </section>
  </div>

  <script type="application/json" id="datos-botin" set:html={JSON.stringify(porRareza)}></script>

  <script>
    import { xpNumerico } from "../../lib/xp";
    import { enteroEnRango } from "../../lib/encuentro";
    import {
      edicionDe,
      dificultadDe,
      dificultadPorDefecto,
      dificultadesDe,
      multiplicadorDe,
      presupuestoDe,
      reglaDe,
      totalDe,
      veredictoDe,
      type EdicionEncuentro,
    } from "../../lib/presupuesto";
    import { plegar } from "../../lib/texto";
    import { buscarPorNombre } from "../../lib/criaturas";
    import { claveVd } from "../../lib/vd";
    import { cargaCatalogo, type MonstruoCatalogo } from "../../lib/catalogo";
    import { CLAVE_INICIATIVA, leerIniciativa, sinCombatiente, type Combatiente } from "../../lib/iniciativa";

    const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
    const azar = <T,>(xs: T[]): T => xs[Math.floor(Math.random() * xs.length)];

    /* ------------------------------------------------------------ encuentros */

    type Monstruo = MonstruoCatalogo;
    let catalogo: Monstruo[] = [];
    // El catálogo puede no llegar —un despliegue a medias, un corte de red—, así
    // que se recuerda si está y qué contar cuando falta: sin esto, un catálogo
    // vacío se leía como «esa criatura no existe».
    let catalogoListo = false;
    let avisoDelCatalogo = "";
    let anadidas: { n: string; xp: number; qty: number }[] = [];

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    /* La regla del presupuesto depende del catálogo: el 5.2.1 trae tres
       dificultades y ningún ajuste por número de criaturas; el 5.1, cuatro
       dificultades y el ajuste. Se aplica la que toca al catálogo elegido, y
       el selector de dificultad se rehace con ella para que no se puedan
       mezclar —el fallo era aplicar la tabla de 2014 sobre el catálogo de
       2024, que mandaba al veredicto al DM en mitad de la partida. */
    let edicion: EdicionEncuentro = "5.5";

    const pintarDificultades = () => {
      const select = $("enc-dif") as HTMLSelectElement | null;
      if (!select) return;
      const lista = dificultadesDe(edicion);
      const actual = select.value;
      select.replaceChildren(
        ...lista.map((d) => {
          const opcion = document.createElement("option");
          opcion.value = d.clave;
          opcion.textContent = d.etiqueta;
          return opcion;
        }),
      );
      // Si la dificultad que había era de la otra edición, se vuelve a la de por
      // defecto de esta: dejarla marcada pintaría un veredicto con una regla
      // que no es la del catálogo.
      select.value = lista.some((d) => d.clave === actual) ? actual : dificultadPorDefecto(edicion).clave;
    };

    const pintarRegla = () => {
      const nota = $("enc-regla");
      if (!nota) return;
      const regla = reglaDe(edicion);
      nota.textContent = `Presupuesto de PX de ${regla.titulo}. ${regla.nota}`;
    };

    const cargarCatalogo = async (ed: string) => {
      const { monstruos, aviso } = await cargaCatalogo(ed, BASE);
      catalogo = monstruos;
      catalogoListo = monstruos.length > 0;
      avisoDelCatalogo = aviso;
      const lista = $("enc-lista") as HTMLDataListElement | null;
      if (lista) {
        lista.innerHTML = catalogo
          .map((m) => `<option value="${m.n.replace(/"/g, "&quot;")}">VD ${m.d.vd} · ${xpNumerico(m.d.xp).toLocaleString("es-ES")} PX</option>`)
          .join("");
      }
      // Sin catálogo el panel lo dice y deja el reintento a mano; con él, se
      // retira el aviso y el botón.
      const reintentar = $("enc-reintentar");
      if (reintentar) reintentar.hidden = catalogoListo;
      avisar(aviso);
      return catalogoListo;
    };

    const pintarEncuentro = () => {
      const cont = $("enc-anadidas");
      const salida = $("enc-salida");
      if (!cont || !salida) return;

      cont.innerHTML = anadidas
        .map(
          (m, i) => `<li>
            <span class="mesa-anadidas__n">${m.qty > 1 ? `${m.qty} × ` : ""}${m.n}</span>
            <span class="num muted">${m.xp} PX</span>
            <span class="mesa-anadidas__acc">
              <button type="button" data-menos="${i}" aria-label="Quitar uno de ${m.n}">−</button>
              <button type="button" data-mas="${i}" aria-label="Añadir uno de ${m.n}">+</button>
            </span>
          </li>`,
        )
        .join("");

      // Los dos campos se teclean a mano: `type=number` no impide 0, 11, -3, un
      // decimal ni dejarlos vacíos. Sin acotarlos, 0 dejaba el presupuesto en 0
      // (ratio Infinity) y 3.5 se salía de la tabla y rompía el repintado.
      const pj = enteroEnRango(($("enc-pj") as HTMLInputElement | null)?.value, 4, 1, 10);
      const nivel = enteroEnRango(($("enc-nivel") as HTMLInputElement | null)?.value, 3, 1, 20);
      const dif = ($("enc-dif") as HTMLSelectElement)?.value ?? dificultadPorDefecto(edicion).clave;
      const presupuesto = presupuestoDe(edicion, nivel, dif, pj);
      const etiquetaDificultad = dificultadDe(edicion, dif).etiqueta;

      const criaturas = anadidas.reduce((n, m) => n + m.qty, 0);
      const base = anadidas.reduce((n, m) => n + m.xp * m.qty, 0);
      const multiplicador = multiplicadorDe(edicion, criaturas);
      const ajustado = totalDe(edicion, base, criaturas);

      if (!criaturas) {
        salida.innerHTML = `<p class="mesa-resumen__cifra">${presupuesto.toLocaleString("es-ES")} PX</p>
          <p class="muted">Presupuesto para ${pj} ${pj === 1 ? "personaje" : "personajes"} de nivel ${nivel} (${etiquetaDificultad.toLowerCase()}). Añade criaturas para comparar.</p>`;
        return;
      }

      const ratio = ajustado / presupuesto;
      const veredicto = veredictoDe(ratio);

      salida.innerHTML = `<p class="mesa-resumen__cifra">${ajustado.toLocaleString("es-ES")} <span>PX ajustados</span></p>
        <p class="muted">${base.toLocaleString("es-ES")} PX base${
          multiplicador === 1 ? "" : ` × ${multiplicador} por ${criaturas} ${criaturas === 1 ? "criatura" : "criaturas"}`
        } · presupuesto ${presupuesto.toLocaleString("es-ES")} PX (${etiquetaDificultad.toLowerCase()})</p>
        <p class="mesa-veredicto mesa-veredicto--${veredicto.clase}">${veredicto.texto} (${Math.round(ratio * 100)} % del presupuesto)</p>`;
    };

    /* El datalist solo dispara `change` al elegir una sugerencia, así que el
       teclado se quedaba sin respuesta: escribir el nombre y pulsar Intro no
       añadía nada. Intro y `change` comparten ahora el mismo camino, y lo que no
       case con el catálogo se dice en el propio panel en vez de en silencio. */
    const avisar = (texto: string) => {
      const aviso = $("enc-aviso");
      if (!aviso) return;
      aviso.textContent = texto;
      aviso.hidden = !texto;
    };

    /* Las tres herramientas de /mesa/ leen el mismo catálogo, así que un catálogo
       que no ha llegado se cuenta igual en las tres. El texto sale de la carga
       —`cargaCatalogo` nombra la edición— y no de tres copias que se
       desincronizan: Ajustar y Estimar se quedaron fuera del arreglo del panel
       de Encuentros y uno culpaba al lector de un fallo de red, el otro ni
       contestaba. */
    const avisoDeCatalogo = () =>
      avisoDelCatalogo ||
      "El catálogo de criaturas no ha cargado: las herramientas de la mesa no pueden buscar en él hasta que vuelva la conexión.";

    /** Escribe ese aviso en la salida de cualquier panel, en vez de su resultado. */
    const pintarAvisoDeCatalogo = (salida: HTMLElement | null) => {
      if (!salida) return;
      // `#vd-salida` ya es un `<p>`: meterle otro dentro sería HTML inválido.
      if (salida.tagName === "P") {
        salida.textContent = avisoDeCatalogo();
        return;
      }
      const p = document.createElement("p");
      p.className = "muted";
      p.textContent = avisoDeCatalogo();
      salida.replaceChildren(p);
    };

    const anadirCriatura = (texto: string): Monstruo | null => {
      const buscado = plegar(texto.trim());
      if (!buscado) return null;
      // Sin catálogo no hay nada que buscar: el fallo es de la carga, no del
      // nombre que se acaba de escribir.
      if (!catalogoListo) {
        avisar(avisoDeCatalogo());
        return null;
      }
      // Vale el nombre exacto y, si no lo hay, un único parecido: «dragon rojo»
      // sin tilde encuentra «Dragón rojo», pero «goblin» es ambiguo y se avisa.
      const exacta = catalogo.find((x) => plegar(x.n) === buscado);
      const parecidas = exacta ? [] : catalogo.filter((x) => plegar(x.n).includes(buscado));
      const m = exacta ?? (parecidas.length === 1 ? parecidas[0] : null);
      if (!m) {
        avisar(
          parecidas.length
            ? `«${texto.trim()}» coincide con ${parecidas.length} criaturas: ${parecidas
                .slice(0, 3)
                .map((x) => x.n)
                .join(", ")}${parecidas.length > 3 ? "…" : ""}. Elige una de la lista.`
            : `No hay ninguna criatura que se llame «${texto.trim()}» en este catálogo.`,
        );
        return null;
      }
      const ya = anadidas.find((x) => x.n === m.n);
      if (ya) ya.qty++;
      else anadidas.push({ n: m.n, xp: xpNumerico(m.d.xp), qty: 1 });
      avisar("");
      pintarEncuentro();
      return m;
    };

    const campoBuscar = $("enc-buscar") as HTMLInputElement | null;

    // Al añadir, el campo se vacía y el foco sigue en él para encadenar criaturas.
    const confirmarCriatura = () => {
      if (!campoBuscar || !anadirCriatura(campoBuscar.value)) return;
      campoBuscar.value = "";
      campoBuscar.focus();
    };

    campoBuscar?.addEventListener("change", confirmarCriatura);
    campoBuscar?.addEventListener("keydown", (ev) => {
      if (ev.key !== "Enter") return;
      ev.preventDefault();
      confirmarCriatura();
    });
    // El aviso deja de tener sentido en cuanto se corrige el texto, salvo el del
    // catálogo caído: ese sigue siendo verdad hasta que la carga funcione.
    campoBuscar?.addEventListener("input", () => avisar(catalogoListo ? "" : avisoDelCatalogo));

    $("enc-anadidas")?.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest("button");
      if (!b) return;
      const i = Number(b.dataset.mas ?? b.dataset.menos);
      if (b.dataset.mas !== undefined) anadidas[i].qty++;
      else if (--anadidas[i].qty <= 0) anadidas.splice(i, 1);
      pintarEncuentro();
    });

    for (const id of ["enc-pj", "enc-nivel", "enc-dif"]) $(id)?.addEventListener("input", pintarEncuentro);
    $("enc-vaciar")?.addEventListener("click", () => {
      anadidas = [];
      pintarEncuentro();
    });
    // Reintentar sin recargar: la página ya está, lo que falta es el JSON.
    $("enc-reintentar")?.addEventListener("click", async () => {
      if (!(await cargarCatalogo(edicion))) return;
      pintarEncuentro();
    });
    $("enc-ed")?.addEventListener("change", async (ev) => {
      // El catálogo manda sobre la regla: al cambiarlo se rehacen las
      // dificultades y el texto que dice qué tabla se está usando, antes de
      // cargar las criaturas del catálogo nuevo.
      const elegida = (ev.target as HTMLSelectElement).value;
      edicion = edicionDe(elegida);
      pintarDificultades();
      pintarRegla();
      anadidas = [];
      // La carga deja el aviso que toque: el de este catálogo o ninguno.
      await cargarCatalogo(elegida);
      pintarEncuentro();
    });

    pintarDificultades();
    pintarRegla();
    cargarCatalogo("5.5").then(pintarEncuentro);


    /* ------------------------------------------------- ajustar criaturas */

    const mediana = (xs: number[]) => {
      if (!xs.length) return 0;
      const o = [...xs].sort((a, b) => a - b);
      const m = Math.floor(o.length / 2);
      return o.length % 2 ? o[m] : (o[m - 1] + o[m]) / 2;
    };

    const numeros = (s: unknown) => Number(String(s ?? "").match(/\d+/)?.[0] ?? 0) || 0;

    const perfiles = () => {
      const mapa = new Map<string, { hp: number[]; ac: number[]; xp: number[]; vd: string }>();
      for (const m of catalogo) {
        const clave = String(m.d.vd ?? "");
        if (!mapa.has(clave)) mapa.set(clave, { hp: [], ac: [], xp: [], vd: clave });
        const p = mapa.get(clave)!;
        const hp = numeros(m.d.pg);
        const ac = numeros(m.d.ca);
        const xp = xpNumerico(m.d.xp);
        if (hp) p.hp.push(hp);
        if (ac) p.ac.push(ac);
        if (xp) p.xp.push(xp);
      }
      return mapa;
    };

    /* El VD del original se enseña en cuanto se elige la criatura: el `<output>`
       de «VD actual» existía justo para eso y se quedaba en «—» para siempre
       porque ningún script lo escribía. */
    const pintarVdActual = () => {
      const salida = $("aj-vd");
      if (!salida) return;
      const nombre = ($("aj-criatura") as HTMLInputElement | null)?.value.trim() ?? "";
      const m = buscarPorNombre(catalogo, nombre);
      salida.textContent = m ? String(m.d.vd ?? "—") : "—";
    };
    $("aj-criatura")?.addEventListener("input", pintarVdActual);
    $("aj-criatura")?.addEventListener("change", pintarVdActual);

    $("aj-calcular")?.addEventListener("click", () => {
      const salida = $("aj-salida");
      // Sin catálogo no hay ninguna criatura que buscar: el fallo es de la
      // carga, no del nombre, y se dice con el mismo texto que en Encuentros.
      if (!catalogoListo) {
        pintarAvisoDeCatalogo(salida);
        return;
      }
      const nombre = ($("aj-criatura") as HTMLInputElement).value.trim();
      const objetivo = String(($("aj-objetivo") as HTMLInputElement).value).trim();
      const m = buscarPorNombre(catalogo, nombre);
      const perfil = perfiles();
      /* El VD se casa por valor, no por texto: el catálogo lo escribe como
         fracción (`1/2`) y el lector lo teclea como quiera (`0.5`, `0,5`). */
      const clave = claveVd(perfil.keys(), objetivo);
      const destino = clave ? perfil.get(clave) : undefined;

      /* Dos fallos distintos no comparten mensaje: un nombre que no está en el
         catálogo y un VD sin ninguna criatura se arreglan de maneras distintas,
         y culpar al VD cuando lo que sobraba era una tilde dejaba al lector
         probando números que sí existen. El texto va con `textContent`, no en
         la plantilla: el nombre lo escribe quien mira la página. */
      const aviso = (texto: string) => {
        if (!salida) return;
        const p = document.createElement("p");
        p.className = "muted";
        p.textContent = texto;
        salida.replaceChildren(p);
      };

      if (!m) {
        aviso(
          nombre
            ? `No hay ninguna criatura que se llame «${nombre}» en este catálogo.`
            : "Escribe el nombre de una criatura del catálogo.",
        );
        return;
      }
      if (!objetivo) {
        aviso("Escribe el VD al que quieres ajustar la criatura.");
        return;
      }
      if (!destino) {
        aviso(`El catálogo no tiene ninguna criatura con VD ${objetivo}: no hay media con la que escalar. Prueba otro VD.`);
        return;
      }

      const origen = perfil.get(String(m.d.vd));
      const hp = numeros(m.d.pg);
      const ac = numeros(m.d.ca);
      const factor = origen && mediana(origen.hp) ? mediana(destino.hp) / mediana(origen.hp) : 1;
      const nuevoHp = Math.max(1, Math.round(hp * factor));
      const nuevaAc = Math.max(1, ac + Math.round(mediana(destino.ac) - mediana(origen?.ac ?? [])));
      const px = mediana(destino.xp);

      if (salida)
        salida.innerHTML = `<p class="mesa-resumen__cifra">VD ${clave} <span>antes ${m.d.vd}</span></p>
          <p><b>PG</b> ${hp} → <b>${nuevoHp}</b> · <b>CA</b> ${ac} → <b>${nuevaAc}</b> · <b>PX</b> ${Math.round(px).toLocaleString("es-ES")}</p>
          <p class="muted">Escala ×${factor.toFixed(2)} sobre la media del VD ${clave}. Sube o baja el daño de sus ataques en la misma proporción.</p>`;
    });

    /* ------------------------------------------------------- estimar VD */

    /**
     * Campo numérico de la herramienta, en positivo o nada.
     *
     * `type=number` no impide dejar el campo vacío, y `Number("")` es 0, así
     * que un PG en blanco entraba como 0 y `Math.log2(hp / 0)` daba Infinity
     * para las 330 criaturas: todas empataban, el comparador devolvía NaN y la
     * herramienta contestaba «VD 10 probable» con la primera del catálogo.
     * Un 0 o un negativo tampoco son un PG ni una CA de verdad.
     */
    const positivo = (valor: string) => {
      const n = Number(valor);
      return Number.isFinite(n) && n > 0 ? n : 0;
    };

    $("vd-estimar")?.addEventListener("click", () => {
      const campoPg = $("vd-pg") as HTMLInputElement;
      const salida = $("vd-salida");
      if (!salida) return;
      // Un botón mudo es peor que un mensaje: sin catálogo no hay vecinas con
      // las que comparar, y eso hay que decirlo.
      if (!catalogoListo) {
        pintarAvisoDeCatalogo(salida);
        return;
      }

      const pg = positivo(campoPg.value);
      const ca = positivo(($("vd-ca") as HTMLInputElement).value);
      if (!pg) {
        campoPg.setAttribute("aria-invalid", "true");
        salida.innerHTML = `<p class="muted">Escribe un PG mayor que 0: sin PG no hay con qué comparar.</p>`;
        return;
      }
      campoPg.removeAttribute("aria-invalid");

      const vecinas = catalogo
        .map((m) => ({
          n: m.n,
          vd: String(m.d.vd),
          hp: numeros(m.d.pg),
          ac: numeros(m.d.ca),
        }))
        .filter((m) => m.hp > 0 && (!ca || m.ac > 0))
        .map((m) => ({ ...m, d: Math.abs(Math.log2(m.hp / pg)) + (ca ? Math.abs(m.ac - ca) / 4 : 0) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, 7);

      if (!vecinas.length) {
        salida.innerHTML = `<p class="muted">El catálogo no tiene criaturas con PG: no hay con qué comparar.</p>`;
        return;
      }

      const pesos = new Map<string, number>();
      for (const v of vecinas) pesos.set(v.vd, (pesos.get(v.vd) ?? 0) + 1);
      const [vdFrecuente] = [...pesos.entries()].sort((a, b) => b[1] - a[1])[0];

      salida.innerHTML = `<strong>VD ${vdFrecuente}</strong> probable.
        <br><span class="muted">Se parece a ${vecinas.slice(0, 3).map((v) => `${v.n} (VD ${v.vd})`).join(", ")}.</span>
        ${ca ? "" : `<br><span class="muted">Sin CA: he comparado solo por PG. Escribe la CA para afinar.</span>`}`;
    });

    /* ------------------------------------------------------------ iniciativa */

    const CLAVE = CLAVE_INICIATIVA;
    let combatientes: Combatiente[] = [];
    let turno = 0;

    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify({ turno, lista: combatientes }));
      } catch {}
    };

    /**
     * Pinta la lista ordenada por iniciativa y deja el turno sobre quien lo
     * tenía. El `sort()` de aquí abajo reordena las filas, así que un índice
     * que valía para el orden anterior pasa a señalar a otra criatura: cuando
     * la lista cambia sin que el DM haya pasado turno (un refuerzo que llega a
     * mitad del combate), el puntero sigue al combatiente por identidad —el
     * objeto, que el nombre se puede repetir— y no por su puesto.
     */
    const pintarIniciativa = (conservar?: Combatiente) => {
      const lista = $("ini-lista");
      if (!lista) return;
      combatientes.sort((a, b) => b.valor - a.valor);
      if (conservar) {
        const i = combatientes.indexOf(conservar);
        turno = i >= 0 ? i : 0;
      }
      if (turno >= combatientes.length) turno = 0;
      lista.replaceChildren(
        ...combatientes.map((c, i) => {
          const fila = document.createElement("li");
          if (i === turno) fila.className = "activo";
          const nombre = document.createElement("span");
          nombre.textContent = c.nombre;
          const valor = document.createElement("span");
          valor.className = "num";
          valor.textContent = String(c.valor);
          // El botón de la fila lleva su propio nombre accesible: el texto
          // «Quitar» repetido en seis filas no dice a quién quita cada uno.
          const quitar = document.createElement("button");
          quitar.type = "button";
          quitar.className = "btn btn--fantasma mesa-iniciativa__quitar";
          quitar.textContent = "Quitar";
          quitar.setAttribute("aria-label", `Quitar a ${c.nombre} del combate`);
          quitar.addEventListener("click", () => quitarCombatiente(i));
          fila.append(nombre, valor, quitar);
          return fila;
        }),
      );
      guardar();
    };

    /**
     * Quita el combatiente que ocupa `indice`. La cuenta del turno vive en
     * `sinCombatiente`, que se prueba sin navegador en `tools/test/iniciativa.mjs`:
     * aquí solo se pinta lo que devuelve.
     */
    const quitarCombatiente = (indice: number) => {
      const siguiente = sinCombatiente({ turno, lista: combatientes }, indice);
      if (!siguiente) return;
      combatientes = siguiente.lista;
      turno = siguiente.turno;
      pintarIniciativa();
    };

    $("ini-vaciar")?.addEventListener("click", () => {
      combatientes = [];
      turno = 0;
      pintarIniciativa();
    });

    $("ini-anadir")?.addEventListener("click", () => {
      const nombre = ($("ini-nombre") as HTMLInputElement).value.trim() || "Sin nombre";
      const valor = Number(($("ini-valor") as HTMLInputElement).value) || 0;
      const activo = combatientes[turno];
      combatientes.push({ nombre, valor });
      ($("ini-nombre") as HTMLInputElement).value = "";
      pintarIniciativa(activo);
    });

    $("ini-siguiente")?.addEventListener("click", () => {
      if (!combatientes.length) return;
      turno = (turno + 1) % combatientes.length;
      pintarIniciativa();
    });

    $("ini-proyectar")?.addEventListener("click", () => {
      guardar();
      window.open(`${BASE}/mesa/jugadores/`, "vista-jugador", "width=1100,height=760");
    });

    /*
     * El combate vive en el navegador, así que al cargar hay que devolverlo a la
     * pantalla. Sin esto, recargar /mesa/ dejaba la lista vacía —«Siguiente
     * turno» no hacía nada— mientras la ventana de los jugadores seguía
     * enseñando el combate guardado, y el primer «Añadir» reescribía la clave
     * con una sola criatura y borraba el orden de la otra pantalla. Se lee con
     * `leerIniciativa`, que valida y ordena igual que la vista del jugador.
     */
    const restaurar = () => {
      let crudo: string | null = null;
      try {
        crudo = localStorage.getItem(CLAVE);
      } catch {}
      const guardado = leerIniciativa(crudo);
      if (!guardado) return;
      combatientes = guardado.lista;
      turno = guardado.turno;
    };

    restaurar();
    pintarIniciativa();

    /* ----------------------------------------------------------------- dados */

    const d = (caras: number) => Math.floor(Math.random() * caras) + 1;
    $("dad-tirar")?.addEventListener("click", () => {
      const entrada = ($("dad-expresion") as HTMLInputElement).value.replace(/\s/g, "");
      const m = /^(\d*)d(\d+)([+-]\d+)?$/i.exec(entrada);
      const salida = $("dad-salida");
      if (!salida) return;
      if (!m) {
        salida.textContent = "Formato: 2d6+3";
        return;
      }
      const n = Number(m[1] || 1);
      const caras = Number(m[2]);
      const mod = Number(m[3] || 0);
      if (n > 100 || caras > 1000) {
        salida.textContent = "Demasiados dados.";
        return;
      }
      const tiradas = Array.from({ length: n }, () => d(caras));
      let total = tiradas.reduce((a, b) => a + b, 0) + mod;
      let extra = "";
      if (($("dad-ventaja") as HTMLInputElement).checked && n === 1 && caras === 20) {
        const primera = tiradas[0];
        const otra = d(20);
        // Los dos d20 tirados se enseñan, no solo el primero: con la lista corta
        // la mitad de las tiradas (las que suman con el segundo dado) anunciaban
        // un total que no aparecía entre los dados —«19 = [3] (la otra: 3)»— y el
        // DM no podía comprobar la tirada que le estaban enseñando.
        tiradas.push(otra);
        total = Math.max(primera, otra) + mod;
        extra =
          primera === otra
            ? " (los dos dados iguales)"
            : ` (se queda el ${Math.max(primera, otra)})`;
      }
      salida.innerHTML = `<strong>${total}</strong> = [${tiradas.join(", ")}]${
        mod ? ` ${mod > 0 ? "+" : "−"} ${Math.abs(mod)}` : ""
      }${extra}`;
    });

    /* ------------------------------------------------------------------- PNJ */

    const NOMBRES = ["Aldara", "Brumo", "Cassia", "Doran", "Elva", "Fermín", "Greta", "Hugo", "Isolda", "Jaro", "Kelia", "Lupo", "Mara", "Néstor", "Olga", "Pietro", "Quina", "Ramiro", "Sela", "Tobías", "Úrsula", "Vasco", "Wenda", "Ximena", "Yago", "Zoe"];
    const OFICIOS = ["herrero", "tabernero", "curandera", "guardia", "cartógrafo", "contrabandista", "escribano", "cazador", "barquero", "sepulturero", "juglar", "boticaria", "armero", "molinero", "sastre", "lacayo"];
    const MANIAS = ["no mira a los ojos cuando miente", "habla siempre en susurros", "cobra por adelantado y sin excepciones", "tiene un cuervo que repite lo que oye", "desconfía de cualquiera con espada", "recuerda todas las deudas, hasta las de cobre", "se ríe en el momento menos oportuno", "lleva guantes incluso en verano", "jura que vio algo en el bosque", "no bebe nada que no sirva él mismo"];

    $("pnj-generar")?.addEventListener("click", () => {
      const s = $("pnj-salida");
      if (s) s.innerHTML = `<strong>${azar(NOMBRES)}</strong>, ${azar(OFICIOS)}. Se rumorea que ${azar(MANIAS)}.`;
    });

    /* ----------------------------------------------------------------- botín */

    $("bot-generar")?.addEventListener("click", () => {
      const datos: Record<string, string[]> = JSON.parse($("datos-botin")?.textContent || "{}");
      const rareza = ($("bot-rareza") as HTMLSelectElement).value;
      const lista = datos[rareza] || [];
      const s = $("bot-salida");
      if (s)
        s.innerHTML = `<strong>${Math.floor(Math.random() * 20) + 1} po</strong> y <strong>${
          Math.floor(Math.random() * 100) + 1
        } pp</strong>; además, <em>${lista.length ? azar(lista) : "un objeto sin identificar"}</em>.`;
    });
  </script>
</Base>
