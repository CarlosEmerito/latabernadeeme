---
import Base from "../layouts/Base.astro";
import { e } from "../lib/urls";
---

<Base title="No encontrado" description="Esa página no existe." ancho>
  <div class="vacio">
    <p class="muted num" style="margin-bottom:0.5rem">404</p>
    <h1 style="font-size:2rem;margin-bottom:0.5rem">Aquí no hay nada</h1>
    <p class="muted">La página no existe o el enlace está mal escrito.</p>
    <p style="margin-top:1.25rem;display:flex;gap:0.5rem;flex-wrap:wrap">
      <a class="btn btn--acento" href={e("/")}>Volver al inicio</a>
      <a class="btn" href={e("/5e/")}>SRD 5.1</a>
      <a class="btn" href={e("/5.5/")}>SRD 5.2.1</a>
      <a class="btn" href={e("/buscar/")}>Buscar</a>
    </p>
  </div>
</Base>
