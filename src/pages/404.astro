---
import Base from "../layouts/Base.astro";
import { e } from "../lib/urls";
---

<Base title="Página no encontrada" description="Esa página no existe en La Taberna de Eme.">
  <section class="heroe">
    <p class="heroe__sub">Error 404</p>
    <h1>Aquí no hay nada</h1>
    <p class="heroe__texto">
      La página que buscas no existe, o el enlace que te han pasado está mal escrito. Puede que el
      conjuro haya fallado.
    </p>
    <p>
      <a class="btn btn--principal" href={e("/")}>Volver a la taberna</a>
      <a class="btn" href={e("/5e/")}>Quinta edición</a>
      <a class="btn" href={e("/5.5/")}>Reglas de 2024</a>
      <a class="btn" href={e("/buscar/")}>Buscar</a>
    </p>
  </section>
</Base>
