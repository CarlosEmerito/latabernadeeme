---
import "../styles/global.css";
import "../styles/tema.css";
import { EDICIONES, TIPOS, TIPO_META, contar, nombreTipo, type Edition, type Tipo } from "../lib/content";
import { e } from "../lib/urls";
import { tarjetaDe } from "../lib/imagenes";
import Icono from "../components/Icono.astro";

interface Props {
  title: string;
  description?: string;
  edicion?: Edition;
  tipo?: Tipo;
  ancho?: boolean;
  /** Sigilo de la entrada, para la tarjeta social; sin él se usa el genérico. */
  imagen?: string;
  /**
   * Sección de la entrada («Conjuro», «Equipo», «Clase»…). Va en el título
   * porque el nombre no basta: «Escudo» es un conjuro y un escudo de equipo, y
   * sin la sección las dos fichas salían con el mismo `<title>`.
   */
  seccion?: string;
  /** `article` en las fichas, `website` en la portada y los listados. */
  tipoOg?: "website" | "article";
  /**
   * Tarjeta social propia, para cuando el sigilo no cuenta lo suficiente. La
   * portada la usa: es la única página que no habla de una entrada concreta.
   */
  tarjeta?: { src: string; ancho: number; alto: number; alt?: string };
}

const {
  title,
  description = "Conjuros, monstruos, objetos, clases y reglas de D&D 5e (2014) y D&D 5.5e (2024) en español, con buscador, filtros y herramientas de mesa.",
  edicion,
  tipo,
  ancho = false,
  imagen,
  seccion,
  tipoOg = "website",
  tarjeta,
} = Astro.props;

const SITIO = "La Taberna de Eme";
const ETIQUETA = edicion ? (edicion === "5e" ? "D&D 5e" : "D&D 5.5e") : "D&D 5e y 5.5e";
const tituloCompleto =
  title === SITIO
    ? `${SITIO} — ${ETIQUETA} en español`
    : [title, seccion, ETIQUETA].filter(Boolean).join(" · ");
const ruta = Astro.url.pathname.replace(/\/$/, "") || "/";
const activo = (href: string) => (ruta === href.replace(/\/$/, "") ? "page" : undefined);
const meta = edicion ? EDICIONES[edicion] : null;
// Sin edición no hay raíl; si la rejilla mantiene su columna, el contenido se
// comprime a 236 px sin desbordar y la captura no lo delata.
const anchoReal = ancho || !edicion;
const base = edicion ? e(`/${edicion}`) : "";
// La canónica lleva el dominio, la base del despliegue y una sola barra final:
// el sitio se publica con `trailingSlash: "always"` y GitHub Pages sirve además
// `/…/index.html`, así que sin canónica cada ficha es indexable en dos
// direcciones y el buscador elige por su cuenta cuál guarda.
const rutaCanonica = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonica = new URL(rutaCanonica, Astro.site ?? Astro.url).href;
// Las redes no pintan un SVG: la tarjeta es el mismo sigilo rasterizado, salvo
// que la página traiga la suya (la portada). El tamaño va con la tarjeta: si se
// anuncia 600×315 y el PNG mide 1200×630, algunas plataformas recortan.
const tarjetaSocial = tarjeta
  ? {
      url: new URL(e(tarjeta.src), Astro.site ?? Astro.url).href,
      ancho: tarjeta.ancho,
      alto: tarjeta.alto,
      alt: tarjeta.alt ?? SITIO,
    }
  : {
      url: new URL(e(tarjetaDe(imagen)), Astro.site ?? Astro.url).href,
      ancho: 600,
      alto: 315,
      alt: imagen ? `Sigilo de ${title}` : SITIO,
    };
---

<!doctype html>
<html lang="es" data-tema="claro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={e("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={e("/manifest.webmanifest")} />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "La Taberna de Eme",
        "alternateName": ["D&D 5e en español", "DnD 5e", "Dungeons & Dragons 5e", "5e y 5.5e"],
        "inLanguage": "es-ES",
        "description": "Referencia de D&D 5e y 5.5e en español: conjuros, monstruos, objetos y herramientas de mesa.",
        "isAccessibleForFree": true
      }
    </script>
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:site_name" content={`${SITIO} · D&D 5e`} />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    <meta name="keywords" content="D&D, DnD, Dungeons & Dragons, D&D 5e, 5e, 5.5e, D&D 2024, SRD, conjuros, monstruos, objetos mágicos, clases, reglas, herramientas de mesa, español" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={tarjetaSocial.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={tarjetaSocial.ancho} />
    <meta property="og:image:height" content={tarjetaSocial.alto} />
    <meta property="og:image:alt" content={tarjetaSocial.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={tarjetaSocial.url} />
    <meta name="twitter:image:alt" content={tarjetaSocial.alt} />
    <script is:inline>
      try {
        const guardado = localStorage.getItem("tema");
        const oscuro = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.tema = guardado || (oscuro ? "oscuro" : "claro");
      } catch (e) {}
    </script>
    <meta name="google-site-verification" content="n97hrc5skxan7gEA8hsetrUcsUGiPJXg-ezXZJZOpI0" />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="marca" href={e("/")}>
        <span class="marca__punto" aria-hidden="true"></span>
        <span class="marca__nombre">La Taberna de Eme</span>
      </a>

      <form class="buscador-top" role="search" aria-label="Buscar en la taberna" action={e("/buscar/")} method="get">
        <span class="lupa" aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="Conjuro, monstruo, objeto…" aria-label="Buscar en la taberna" />
        <kbd>↵</kbd>
      </form>

      <div class="topbar__acciones">
        <div class="segmento" role="group" aria-label="Edición">
          <a href={e("/5e/")} aria-current={ruta.startsWith(e("/5e")) ? "page" : undefined}>5e</a>
          <a href={e("/5.5/")} aria-current={ruta.startsWith(e("/5.5")) ? "page" : undefined}>5.5</a>
        </div>
        <a class="enlace-top" href={e("/mesa/")} aria-current={activo(e("/mesa/"))}>Mesa</a>
        <button class="icono-btn" id="boton-tema" type="button" aria-label="Cambiar entre tema claro y oscuro">
          <span id="icono-tema" aria-hidden="true">◐</span>
        </button>
      </div>
    </header>

    <div class:list={["shell", anchoReal && "shell--ancho"]}>
      {meta && (
        <nav class="rail" aria-label="Contenido">
          <div class="rail__grupo">
            <p class="rail__titulo">D&amp;D {edicion === "5e" ? "5e" : "5.5e"} · {meta.srd}</p>
            <ul class="rail__lista">
              <li>
                <a href={`${base}/`} aria-current={!tipo ? "page" : undefined}>
                  <span>Portada</span>
                </a>
              </li>
              {TIPOS.map((t) => {
                const n = contar(edicion!, t);
                if (n === 0) return null;
                return (
                  <li>
                    <a href={`${base}/${t}/`} aria-current={tipo === t ? "page" : undefined}>
                      <Icono nombre={`seccion-${t}`} clase="icono--rail" />
                      <span>{nombreTipo(edicion, t)}</span>
                      <span class="rail__cuenta">{n}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
          <div class="rail__grupo rail__grupo--secundario">
            <p class="rail__titulo">Otra edición</p>
            <ul class="rail__lista">
              <li>
                <a href={e(`/${edicion === "5e" ? "5.5" : "5e"}/${tipo ? `${tipo}/` : ""}`)}>
                  <span>{edicion === "5e" ? "D&D 5.5e · SRD 5.2.1" : "D&D 5e · SRD 5.1"}</span>
                </a>
              </li>
              <li>
                <a href={e(`/${edicion}/cartas/`)}>
                  <span>Cartas de conjuros</span>
                </a>
              </li>
              <li>
                <a href={e("/cambios/")}>
                  <span>Qué cambia entre ediciones</span>
                </a>
              </li>
            </ul>
          </div>
        </nav>
      )}

      <main class:list={["main", tipo && `tipo-${tipo}`]} id="contenido">
        <slot />
      </main>
    </div>

    <footer class="pie">
      <div class="pie__interior">
        <div>
          <p>
            Esta obra incluye material procedente del documento de referencia del sistema 5.1
            («SRD 5.1») y del documento de referencia del sistema 5.2.1 («SRD 5.2.1») de Wizards of
            the Coast LLC, disponibles en <a href="https://www.dndbeyond.com/srd" rel="noopener">dndbeyond.com/srd</a>.
            Ambos se distribuyen bajo la licencia internacional de atribución 4.0 de Creative
            Commons (<a href="https://creativecommons.org/licenses/by/4.0/legalcode.es" rel="noopener">CC BY 4.0</a>).
          </p>
        </div>
        <div>
          <p>
            <strong>Dungeons &amp; Dragons</strong>, <strong>D&amp;D</strong>, <strong>D&amp;D Beyond</strong>,
            <strong>Wizards of the Coast</strong>, el ampersand del dragón y los nombres de sus productos son
            marcas registradas de Wizards of the Coast LLC en EE. UU. y otros países.
            <br />
            La Taberna de Eme es un proyecto independiente: no está afiliado, patrocinado ni respaldado por
            Wizards of the Coast. Declara ser <em>compatible con la quinta edición («5E»)</em>, conforme a lo
            previsto en el propio SRD.
          </p>
          <p>
            <a href={e("/cambios/")}>Qué cambia entre ediciones</a> ·
            <a href={e("/mesa/")}>Mesa</a> ·
            <a href={e("/licencias/")}>Licencias y fuentes</a> ·
            <a href={e("/accesibilidad/")}>Accesibilidad</a>
          </p>
          <p class="muted" style="font-size:.72rem">
            Iconos de <a href="https://game-icons.net/" rel="noopener">game-icons.net</a> (CC BY 3.0) ·
            sigilos dibujados por el propio sitio
          </p>
        </div>
      </div>
    </footer>

    <script>
      /* Tarjetas emergentes: al pasar o enfocar un enlace enlazado, se muestra un
         resumen de la entrada. Es una mejora: el enlace funciona sin esto. */
      const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
      /* La tarjeta pide el índice delgado de su edición, no el catálogo entero:
         de `/datos/<ed>.json` solo usa el nombre y tres o cuatro campos, y ese
         fichero pesa 300 KB porque lleva todas las entradas con sus facetas. */
      const cacheDatos = new Map<string, Promise<any>>();
      const cargarDatos = (ed: string) => {
        if (!cacheDatos.has(ed)) {
          cacheDatos.set(
            ed,
            fetch(`${BASE}/datos/${ed}-tarjetas.json`)
              .then((r) => (r.ok ? r.json() : null))
              .catch(() => null),
          );
        }
        return cacheDatos.get(ed)!;
      };

      /* Cada fila del índice es una lista de valores en el orden que declara
         `campos[tipo]`; los textos vienen una sola vez en `textos` y la fila
         guarda su índice en negativo. */
      const entradaDeTarjeta = (indice: any, clave: string) => {
        const [tipo, slug] = clave.split("/");
        const fila = indice?.[tipo]?.[slug];
        const campos = indice?.campos?.[tipo];
        if (!fila || !campos) return null;
        const d: Record<string, any> = {};
        campos.forEach((campo: string, i: number) => {
          const v = fila[i];
          d[campo] = typeof v === "number" && v < 0 ? indice.textos[-v - 1] : v;
        });
        return { t: tipo, n: d[campos[0]], d };
      };

      let tarjeta: HTMLDivElement | null = null;
      let temporizador = 0;
      let actual: HTMLAnchorElement | null = null;

      const ocultar = () => {
        window.clearTimeout(temporizador);
        if (tarjeta) tarjeta.hidden = true;
      };

      const pintar = (e: any, a: HTMLAnchorElement) => {
        if (!tarjeta) {
          tarjeta = document.createElement("div");
          tarjeta.className = "tarjeta-datos";
          tarjeta.setAttribute("role", "tooltip");
          tarjeta.hidden = true;
          document.body.appendChild(tarjeta);
        }
        const d = e.d ?? {};
        const filas: string[] = [];
        if (e.t === "conjuros") {
          filas.push(`<b>${d.nivel === 0 ? "Truco" : `Nivel ${d.nivel}`}</b> · ${d.escuela ?? ""}`);
          if (d.tiempo) filas.push(`<span>Tiempo</span> ${d.tiempo}`);
          if (d.alcance) filas.push(`<span>Alcance</span> ${d.alcance}`);
          if (d.duracion) filas.push(`<span>Duración</span> ${d.duracion}`);
        } else if (e.t === "monstruos") {
          filas.push(`${d.tamano ?? ""} ${String(d.tipo ?? "").toLowerCase()} · <b>VD ${d.vd}</b>`);
          if (d.ca) filas.push(`<span>CA</span> ${d.ca}`);
          if (d.pg) filas.push(`<span>PG</span> ${d.pg}`);
        } else {
          if (d.rareza) filas.push(`<b>${d.rareza}</b>`);
          if (d.precio) filas.push(`<span>Precio</span> ${d.precio}`);
        }
        tarjeta.innerHTML = `<p class="tarjeta-datos__n">${e.n}</p>${filas
          .map((f) => `<p class="tarjeta-datos__f">${f}</p>`)
          .join("")}<p class="tarjeta-datos__pie">${e.t === "conjuros" ? "Conjuro" : e.t === "monstruos" ? "Criatura" : "Objeto"}</p>`;
        tarjeta.hidden = false;

        const r = a.getBoundingClientRect();
        const ancho = 300;
        const izquierda = Math.min(Math.max(8, r.left), window.innerWidth - ancho - 8);
        tarjeta.style.left = `${izquierda + window.scrollX}px`;
        tarjeta.style.top = `${r.bottom + window.scrollY + 6}px`;
      };

      document.addEventListener("pointerover", (ev) => {
        const a = (ev.target as HTMLElement)?.closest?.("a[data-tarjeta]") as HTMLAnchorElement | null;
        if (!a || a === actual) return;
        actual = a;
        const clave = a.dataset.tarjeta!;
        const ed = a.dataset.ed ?? "5.5";
        window.clearTimeout(temporizador);
        temporizador = window.setTimeout(async () => {
          const indice = await cargarDatos(ed);
          const e = entradaDeTarjeta(indice, clave);
          if (e && actual === a) pintar(e, a);
        }, 120);
      });

      document.addEventListener("pointerout", (ev) => {
        const a = (ev.target as HTMLElement)?.closest?.("a[data-tarjeta]");
        if (a) {
          actual = null;
          ocultar();
        }
      });

      document.addEventListener("focusin", (ev) => {
        const a = (ev.target as HTMLElement)?.closest?.("a[data-tarjeta]") as HTMLAnchorElement | null;
        if (a) {
          actual = a;
          cargarDatos(a.dataset.ed ?? "5.5").then((indice) => {
            const e = entradaDeTarjeta(indice, a.dataset.tarjeta!);
            if (e) pintar(e, a);
          });
        }
      });

      document.addEventListener("focusout", ocultar);
      document.addEventListener("keydown", (ev) => {
        if (ev.key === "Escape") ocultar();
      });
      window.addEventListener("scroll", ocultar, { passive: true });
    </script>

    <script>
      const boton = document.getElementById("boton-tema");
      const icono = document.getElementById("icono-tema");
      const pintar = () => {
        const oscuro = document.documentElement.dataset.tema === "oscuro";
        if (icono) icono.textContent = oscuro ? "☀" : "☾";
        boton?.setAttribute("aria-pressed", String(oscuro));
      };
      pintar();
      boton?.addEventListener("click", () => {
        const oscuro = document.documentElement.dataset.tema === "oscuro";
        document.documentElement.dataset.tema = oscuro ? "claro" : "oscuro";
        try {
          localStorage.setItem("tema", document.documentElement.dataset.tema);
        } catch (e) {}
        pintar();
      });

      // Atajo de búsqueda: "/" enfoca el campo.
      document.addEventListener("keydown", (ev) => {
        if (ev.key === "/" && !/input|textarea|select/i.test((ev.target as HTMLElement).tagName)) {
          ev.preventDefault();
          document.querySelector<HTMLInputElement>(".buscador-top input")?.focus();
        }
      });
    </script>
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7cf38b8b5f384223995dd02f755d301e"}'></script>
  </body>
</html>
