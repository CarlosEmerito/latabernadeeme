---
import Base from "../layouts/Base.astro";
import { EDICIONES, TIPOS, TIPO_META, contar, type Edition } from "../lib/content";
import { e } from "../lib/urls";

const ediciones = (["5e", "5.5"] as Edition[]).map((ed) => ({
  ed,
  ...EDICIONES[ed],
  secciones: TIPOS.map((t) => ({ t, n: contar(ed, t) })).filter((x) => x.n > 0),
}));

const atajos = [
  { texto: "Bola de fuego", href: e("/5.5/conjuros/bola-de-fuego/") },
  { texto: "Goblin", href: e("/5.5/monstruos/goblin/") },
  { texto: "Cota de malla", href: e("/5e/equipo/cota-de-malla/") },
  { texto: "Bárbaro", href: e("/5.5/clases/barbaro/") },
  { texto: "Condiciones", href: e("/5.5/reglas/") },
];
---

<Base
  title="La Taberna de Eme"
  description="Conjuros, monstruos, objetos, clases y reglas de D&D quinta edición y de las reglas de 2024, en español y con herramientas de mesa."
  ancho
>
  <section class="portada">
    <h1 style="font-size:clamp(2rem,1.4rem+2vw,2.9rem);max-width:18ch">
      Todo el SRD, en español y sin ruido.
    </h1>
    <p class="muted" style="max-width:60ch;margin-bottom:1.75rem">
      Dos ediciones, {contar("5e", "conjuros") + contar("5.5", "conjuros")} conjuros,
      {contar("5e", "monstruos") + contar("5.5", "monstruos")} monstruos y el resto del contenido
      abierto, con búsqueda instantánea y filtros que funcionan sin JavaScript.
    </p>

    <form class="portada__buscar" role="search" aria-label="Buscar en el catálogo" action={e("/buscar/")} method="get">
      <label class="oculto-visual" for="q">Buscar</label>
      <input id="q" type="search" name="q" placeholder="Busca un conjuro, un monstruo, un objeto…" />
    </form>
    <div class="portada__atajos">
      <span>Prueba:</span>
      {atajos.map((a) => <a href={a.href}>{a.texto}</a>)}
    </div>

    <div class="ediciones-tabla">
      {ediciones.map((ed) => (
        <div class="edicion-bloque">
          <h2>{ed.srd}</h2>
          <p class="edicion-bloque__nota">{ed.nota} · <a href={e(`/${ed.ed}/`)}>entrar</a></p>
          <ul>
            {ed.secciones.map((s) => (
              <li>
                <a href={e(`/${ed.ed}/${s.t}/`)}>{TIPO_META[s.t].plural}</a>
                <span class="num muted">{s.n}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
