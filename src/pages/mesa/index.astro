---
import Base from "../../layouts/Base.astro";
import MesaNav from "../../components/MesaNav.astro";
import { cargar } from "../../lib/content";
import { e } from "../../lib/urls";

const objetos51 = cargar("5e", "objetos");
const porRareza: Record<string, string[]> = {};
for (const o of objetos51) {
  const r = String(o.data.rarity || "sin rareza").toLowerCase();
  (porRareza[r] ??= []).push(String(o.data.name));
}
---

<Base title="Mesa" description="Constructor de encuentros, iniciativa, dados, PNJ y botín para tus partidas." ancho>
  <header class="cabecera">
    <div>
      <h1>Mesa</h1>
      <p class="cabecera__lede">
        Herramientas para el minuto exacto en que la partida se atasca. Nada se guarda en ningún
        servidor: todo vive en tu navegador.
      </p>
    </div>
  </header>

  <MesaNav />

  <div class="mesa-grid">
    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-pantalla">
      <h2 id="p-pantalla">Pantalla del DM</h2>
      <p class="mesa-panel__nota">
        Condiciones, acciones, exploración y peligros en una sola pantalla. Elige qué paneles
        quieres, la elección se recuerda en este navegador y se imprime tal cual para tenerla
        delante en la partida.
      </p>
      <a class="btn btn--acento" href={e("/mesa/pantalla/")}>Abrir la pantalla del DM</a>
    </section>

    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-encuentros">
      <h2 id="p-encuentros">Encuentros</h2>
      <p class="mesa-panel__nota">
        Presupuesto de PX de las reglas de 2014. Añade criaturas del catálogo y compara el total
        ajustado con lo que aguanta el grupo.
      </p>

      <div class="mesa-fila">
        <label>Catálogo
          <select id="enc-ed">
            <option value="5.5" selected>5.2.1 (2024)</option>
            <option value="5e">5.1 (2014)</option>
          </select>
        </label>
        <label>Personajes <input type="number" id="enc-pj" min="1" max="10" value="4" /></label>
        <label>Nivel <input type="number" id="enc-nivel" min="1" max="20" value="3" /></label>
        <label>Dificultad
          <select id="enc-dif" aria-label="Dificultad del encuentro">
            <option value="facil">Fácil</option>
            <option value="media" selected>Media</option>
            <option value="dificil">Difícil</option>
            <option value="mortal">Mortal</option>
          </select>
        </label>
      </div>

      <label class="mesa-buscador">
        <span>Añadir criatura</span>
        <input type="search" id="enc-buscar" list="enc-lista" placeholder="Goblin, lobo, dragón rojo…" autocomplete="off" aria-describedby="enc-aviso" />
        <datalist id="enc-lista"></datalist>
      </label>
      <p class="mesa-aviso" id="enc-aviso" role="status" hidden></p>

      <ul id="enc-anadidas" class="mesa-anadidas" aria-live="polite"></ul>

      <div class="mesa-resumen" id="enc-salida" aria-live="polite"></div>
      <button class="btn btn--fantasma" type="button" id="enc-vaciar">Vaciar</button>
    </section>


    <section class="mesa-panel mesa-panel--ancho" aria-labelledby="p-ajustar">
      <h2 id="p-ajustar">Ajustar una criatura</h2>
      <p class="mesa-panel__nota">
        Sube o baja el valor de desafío de una criatura del catálogo tomando como referencia la media
        de PG y CA de las criaturas de ese VD. Es una aproximación de mesa, no una regla del manual.
      </p>
      <div class="mesa-fila">
        <label class="mesa-ancho">Criatura
          <input type="search" id="aj-criatura" list="enc-lista" placeholder="Guerrero goblin, trol, aboleth…" autocomplete="off" />
        </label>
        <label>VD actual <output id="aj-vd">—</output></label>
        <label>VD objetivo <input type="number" id="aj-objetivo" min="0" max="30" step="1" value="5" /></label>
        <button class="btn btn--acento" type="button" id="aj-calcular">Ajustar</button>
      </div>
      <div id="aj-salida" class="mesa-resumen" aria-live="polite">
        <p class="muted">Elige una criatura y un VD objetivo.</p>
      </div>
    </section>

    <section class="mesa-panel" aria-labelledby="p-vd">
      <h2 id="p-vd">Estimar VD</h2>
      <p class="mesa-panel__nota">Para una criatura propia: con su PG y su CA busco sus vecinas. Si no sabes la CA, se estima solo por PG.</p>
      <div class="mesa-fila">
        <label>PG <input type="number" id="vd-pg" min="1" value="45" /></label>
        <label>CA <input type="number" id="vd-ca" min="1" value="15" /></label>
      </div>
      <button class="btn btn--acento" type="button" id="vd-estimar">Estimar</button>
      <p class="salida" id="vd-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-iniciativa">
      <h2 id="p-iniciativa">Iniciativa</h2>
      <div class="mesa-fila">
        <label>Nombre <input type="text" id="ini-nombre" placeholder="Goblin 1" /></label>
        <label>Valor <input type="number" id="ini-valor" value="10" /></label>
      </div>
      <div class="mesa-botones">
        <button class="btn" type="button" id="ini-anadir">Añadir</button>
        <button class="btn btn--acento" type="button" id="ini-siguiente">Siguiente turno</button>
      </div>
      <ol id="ini-lista" class="mesa-iniciativa" aria-live="polite"></ol>
      <button class="btn btn--fantasma" type="button" id="ini-proyectar">Abrir vista de jugador</button>
    </section>

    <section class="mesa-panel" aria-labelledby="p-dados">
      <h2 id="p-dados">Dados</h2>
      <div class="mesa-fila">
        <label>Tirada <input type="text" id="dad-expresion" value="1d20+5" /></label>
        <label class="mesa-check">Ventaja <input type="checkbox" id="dad-ventaja" /></label>
      </div>
      <button class="btn btn--acento" type="button" id="dad-tirar">Tirar</button>
      <p class="salida" id="dad-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-pnj">
      <h2 id="p-pnj">PNJ de improviso</h2>
      <button class="btn btn--acento" type="button" id="pnj-generar">Generar</button>
      <p class="salida" id="pnj-salida" aria-live="polite"></p>
    </section>

    <section class="mesa-panel" aria-labelledby="p-botin">
      <h2 id="p-botin">Botín</h2>
      <div class="mesa-fila">
        <label>Rareza
          <select id="bot-rareza" aria-label="Rareza del objeto mágico">
            <option value="común">Común</option>
            <option value="poco común" selected>Poco común</option>
            <option value="raro">Raro</option>
            <option value="muy raro">Muy raro</option>
            <option value="legendario">Legendario</option>
          </select>
        </label>
      </div>
      <button class="btn btn--acento" type="button" id="bot-generar">Generar botín</button>
      <p class="salida" id="bot-salida" aria-live="polite"></p>
    </section>
  </div>

  <script type="application/json" id="datos-botin" set:html={JSON.stringify(porRareza)}></script>

  <script>
    import { xpNumerico } from "../../lib/xp";
    import { enteroEnRango } from "../../lib/encuentro";
    import { plegar } from "../../lib/texto";

    const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
    const azar = <T,>(xs: T[]): T => xs[Math.floor(Math.random() * xs.length)];

    /* ------------------------------------------------------------ encuentros */

    const UMBRALES: Record<number, [number, number, number, number]> = {
      1: [25, 50, 75, 100], 2: [50, 100, 150, 200], 3: [75, 150, 225, 400], 4: [125, 250, 375, 500],
      5: [250, 500, 750, 1100], 6: [300, 600, 900, 1400], 7: [350, 750, 1100, 1700], 8: [450, 900, 1400, 2100],
      9: [550, 1100, 1600, 2400], 10: [600, 1200, 1900, 2800], 11: [800, 1600, 2400, 3600], 12: [1000, 2000, 3000, 4500],
      13: [1100, 2200, 3400, 5100], 14: [1250, 2500, 3800, 5700], 15: [1400, 2800, 4300, 6400], 16: [1600, 3200, 4800, 7200],
      17: [2000, 3900, 5900, 8800], 18: [2100, 4200, 6300, 9500], 19: [2400, 4900, 7300, 10900], 20: [2800, 5700, 8500, 12700],
    };
    const IDX: Record<string, number> = { facil: 0, media: 1, dificil: 2, mortal: 3 };
    const multiplicador = (n: number) => (n <= 1 ? 1 : n === 2 ? 1.5 : n <= 6 ? 2 : n <= 10 ? 2.5 : n <= 14 ? 3 : 4);

    type Monstruo = { s: string; n: string; d: { vd: string; xp: number | string; tipo: string; tamano: string } };
    let catalogo: Monstruo[] = [];
    let anadidas: { n: string; xp: number; qty: number }[] = [];

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    const cargarCatalogo = async (ed: string) => {
      const r = await fetch(`${BASE}/datos/${ed}.json`);
      const j = await r.json();
      catalogo = (j.entradas as any[]).filter((e) => e.t === "monstruos");
      const lista = $("enc-lista") as HTMLDataListElement | null;
      if (lista) {
        lista.innerHTML = catalogo
          .map((m) => `<option value="${m.n.replace(/"/g, "&quot;")}">VD ${m.d.vd} · ${xpNumerico(m.d.xp).toLocaleString("es-ES")} PX</option>`)
          .join("");
      }
    };

    const pintarEncuentro = () => {
      const cont = $("enc-anadidas");
      const salida = $("enc-salida");
      if (!cont || !salida) return;

      cont.innerHTML = anadidas
        .map(
          (m, i) => `<li>
            <span class="mesa-anadidas__n">${m.qty > 1 ? `${m.qty} × ` : ""}${m.n}</span>
            <span class="num muted">${m.xp} PX</span>
            <span class="mesa-anadidas__acc">
              <button type="button" data-menos="${i}" aria-label="Quitar uno de ${m.n}">−</button>
              <button type="button" data-mas="${i}" aria-label="Añadir uno de ${m.n}">+</button>
            </span>
          </li>`,
        )
        .join("");

      // Los dos campos se teclean a mano: `type=number` no impide 0, 11, -3, un
      // decimal ni dejarlos vacíos. Sin acotarlos, 0 dejaba el presupuesto en 0
      // (ratio Infinity) y 3.5 se salía de UMBRALES y rompía el repintado.
      const pj = enteroEnRango(($("enc-pj") as HTMLInputElement | null)?.value, 4, 1, 10);
      const nivel = enteroEnRango(($("enc-nivel") as HTMLInputElement | null)?.value, 3, 1, 20);
      const dif = ($("enc-dif") as HTMLSelectElement)?.value ?? "media";
      const umbral = UMBRALES[nivel] ?? UMBRALES[3];
      const presupuesto = umbral[IDX[dif] ?? IDX.media] * pj;

      const criaturas = anadidas.reduce((n, m) => n + m.qty, 0);
      const base = anadidas.reduce((n, m) => n + m.xp * m.qty, 0);
      const ajustado = Math.round(base * multiplicador(criaturas));

      if (!criaturas) {
        salida.innerHTML = `<p class="mesa-resumen__cifra">${presupuesto.toLocaleString("es-ES")} PX</p>
          <p class="muted">Presupuesto para ${pj} ${pj === 1 ? "personaje" : "personajes"} de nivel ${nivel} (${dif}). Añade criaturas para comparar.</p>`;
        return;
      }

      const ratio = ajustado / presupuesto;
      const veredicto =
        ratio < 0.6 ? ["Holgado", "bien"] : ratio < 1 ? ["En presupuesto", "bien"] : ratio < 1.25 ? ["Al límite", "ojo"] : ["Por encima", "mal"];

      salida.innerHTML = `<p class="mesa-resumen__cifra">${ajustado.toLocaleString("es-ES")} <span>PX ajustados</span></p>
        <p class="muted">${base.toLocaleString("es-ES")} PX base × ${multiplicador(criaturas)} por ${criaturas} ${
          criaturas === 1 ? "criatura" : "criaturas"
        } · presupuesto ${presupuesto.toLocaleString("es-ES")} PX</p>
        <p class="mesa-veredicto mesa-veredicto--${veredicto[1]}">${veredicto[0]} (${Math.round(ratio * 100)} % del presupuesto)</p>`;
    };

    /* El datalist solo dispara `change` al elegir una sugerencia, así que el
       teclado se quedaba sin respuesta: escribir el nombre y pulsar Intro no
       añadía nada. Intro y `change` comparten ahora el mismo camino, y lo que no
       case con el catálogo se dice en el propio panel en vez de en silencio. */
    const avisar = (texto: string) => {
      const aviso = $("enc-aviso");
      if (!aviso) return;
      aviso.textContent = texto;
      aviso.hidden = !texto;
    };

    const anadirCriatura = (texto: string): Monstruo | null => {
      const buscado = plegar(texto.trim());
      if (!buscado) return null;
      // Vale el nombre exacto y, si no lo hay, un único parecido: «dragon rojo»
      // sin tilde encuentra «Dragón rojo», pero «goblin» es ambiguo y se avisa.
      const exacta = catalogo.find((x) => plegar(x.n) === buscado);
      const parecidas = exacta ? [] : catalogo.filter((x) => plegar(x.n).includes(buscado));
      const m = exacta ?? (parecidas.length === 1 ? parecidas[0] : null);
      if (!m) {
        avisar(
          parecidas.length
            ? `«${texto.trim()}» coincide con ${parecidas.length} criaturas: ${parecidas
                .slice(0, 3)
                .map((x) => x.n)
                .join(", ")}${parecidas.length > 3 ? "…" : ""}. Elige una de la lista.`
            : `No hay ninguna criatura que se llame «${texto.trim()}» en este catálogo.`,
        );
        return null;
      }
      const ya = anadidas.find((x) => x.n === m.n);
      if (ya) ya.qty++;
      else anadidas.push({ n: m.n, xp: xpNumerico(m.d.xp), qty: 1 });
      avisar("");
      pintarEncuentro();
      return m;
    };

    const campoBuscar = $("enc-buscar") as HTMLInputElement | null;

    // Al añadir, el campo se vacía y el foco sigue en él para encadenar criaturas.
    const confirmarCriatura = () => {
      if (!campoBuscar || !anadirCriatura(campoBuscar.value)) return;
      campoBuscar.value = "";
      campoBuscar.focus();
    };

    campoBuscar?.addEventListener("change", confirmarCriatura);
    campoBuscar?.addEventListener("keydown", (ev) => {
      if (ev.key !== "Enter") return;
      ev.preventDefault();
      confirmarCriatura();
    });
    // El aviso deja de tener sentido en cuanto se corrige el texto.
    campoBuscar?.addEventListener("input", () => avisar(""));

    $("enc-anadidas")?.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest("button");
      if (!b) return;
      const i = Number(b.dataset.mas ?? b.dataset.menos);
      if (b.dataset.mas !== undefined) anadidas[i].qty++;
      else if (--anadidas[i].qty <= 0) anadidas.splice(i, 1);
      pintarEncuentro();
    });

    for (const id of ["enc-pj", "enc-nivel", "enc-dif"]) $(id)?.addEventListener("input", pintarEncuentro);
    $("enc-vaciar")?.addEventListener("click", () => {
      anadidas = [];
      pintarEncuentro();
    });
    $("enc-ed")?.addEventListener("change", async (ev) => {
      await cargarCatalogo((ev.target as HTMLSelectElement).value);
      anadidas = [];
      avisar("");
      pintarEncuentro();
    });

    cargarCatalogo("5.5").then(pintarEncuentro);


    /* ------------------------------------------------- ajustar criaturas */

    const mediana = (xs: number[]) => {
      if (!xs.length) return 0;
      const o = [...xs].sort((a, b) => a - b);
      const m = Math.floor(o.length / 2);
      return o.length % 2 ? o[m] : (o[m - 1] + o[m]) / 2;
    };

    const numeros = (s: unknown) => Number(String(s ?? "").match(/\d+/)?.[0] ?? 0) || 0;

    const perfiles = () => {
      const mapa = new Map<string, { hp: number[]; ac: number[]; xp: number[]; vd: string }>();
      for (const m of catalogo) {
        const clave = String(m.d.vd ?? "");
        if (!mapa.has(clave)) mapa.set(clave, { hp: [], ac: [], xp: [], vd: clave });
        const p = mapa.get(clave)!;
        const hp = numeros(m.d.pg);
        const ac = numeros(m.d.ca);
        const xp = xpNumerico(m.d.xp);
        if (hp) p.hp.push(hp);
        if (ac) p.ac.push(ac);
        if (xp) p.xp.push(xp);
      }
      return mapa;
    };

    $("aj-calcular")?.addEventListener("click", () => {
      const salida = $("aj-salida");
      const nombre = ($("aj-criatura") as HTMLInputElement).value.trim();
      const objetivo = String(($("aj-objetivo") as HTMLInputElement).value).trim();
      const m = catalogo.find((x) => x.n.toLowerCase() === nombre.toLowerCase());
      const perfil = perfiles();
      const destino = perfil.get(objetivo);

      if (!m || !destino) {
        if (salida) salida.innerHTML = `<p class="muted">Elige una criatura del catálogo y un VD que exista en él.</p>`;
        return;
      }

      const origen = perfil.get(String(m.d.vd));
      const hp = numeros(m.d.pg);
      const ac = numeros(m.d.ca);
      const factor = origen && mediana(origen.hp) ? mediana(destino.hp) / mediana(origen.hp) : 1;
      const nuevoHp = Math.max(1, Math.round(hp * factor));
      const nuevaAc = Math.max(1, ac + Math.round(mediana(destino.ac) - mediana(origen?.ac ?? [])));
      const px = mediana(destino.xp);

      if (salida)
        salida.innerHTML = `<p class="mesa-resumen__cifra">VD ${objetivo} <span>antes ${m.d.vd}</span></p>
          <p><b>PG</b> ${hp} → <b>${nuevoHp}</b> · <b>CA</b> ${ac} → <b>${nuevaAc}</b> · <b>PX</b> ${Math.round(px).toLocaleString("es-ES")}</p>
          <p class="muted">Escala ×${factor.toFixed(2)} sobre la media del VD ${objetivo}. Sube o baja el daño de sus ataques en la misma proporción.</p>`;
    });

    /* ------------------------------------------------------- estimar VD */

    /**
     * Campo numérico de la herramienta, en positivo o nada.
     *
     * `type=number` no impide dejar el campo vacío, y `Number("")` es 0, así
     * que un PG en blanco entraba como 0 y `Math.log2(hp / 0)` daba Infinity
     * para las 330 criaturas: todas empataban, el comparador devolvía NaN y la
     * herramienta contestaba «VD 10 probable» con la primera del catálogo.
     * Un 0 o un negativo tampoco son un PG ni una CA de verdad.
     */
    const positivo = (valor: string) => {
      const n = Number(valor);
      return Number.isFinite(n) && n > 0 ? n : 0;
    };

    $("vd-estimar")?.addEventListener("click", () => {
      const campoPg = $("vd-pg") as HTMLInputElement;
      const salida = $("vd-salida");
      if (!salida || !catalogo.length) return;

      const pg = positivo(campoPg.value);
      const ca = positivo(($("vd-ca") as HTMLInputElement).value);
      if (!pg) {
        campoPg.setAttribute("aria-invalid", "true");
        salida.innerHTML = `<p class="muted">Escribe un PG mayor que 0: sin PG no hay con qué comparar.</p>`;
        return;
      }
      campoPg.removeAttribute("aria-invalid");

      const vecinas = catalogo
        .map((m) => ({
          n: m.n,
          vd: String(m.d.vd),
          hp: numeros(m.d.pg),
          ac: numeros(m.d.ca),
        }))
        .filter((m) => m.hp > 0 && (!ca || m.ac > 0))
        .map((m) => ({ ...m, d: Math.abs(Math.log2(m.hp / pg)) + (ca ? Math.abs(m.ac - ca) / 4 : 0) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, 7);

      if (!vecinas.length) {
        salida.innerHTML = `<p class="muted">El catálogo no tiene criaturas con PG: no hay con qué comparar.</p>`;
        return;
      }

      const pesos = new Map<string, number>();
      for (const v of vecinas) pesos.set(v.vd, (pesos.get(v.vd) ?? 0) + 1);
      const [vdFrecuente] = [...pesos.entries()].sort((a, b) => b[1] - a[1])[0];

      salida.innerHTML = `<strong>VD ${vdFrecuente}</strong> probable.
        <br><span class="muted">Se parece a ${vecinas.slice(0, 3).map((v) => `${v.n} (VD ${v.vd})`).join(", ")}.</span>
        ${ca ? "" : `<br><span class="muted">Sin CA: he comparado solo por PG. Escribe la CA para afinar.</span>`}`;
    });

    /* ------------------------------------------------------------ iniciativa */

    type C = { nombre: string; valor: number };
    const CLAVE = "taberna:iniciativa";
    let combatientes: C[] = [];
    let turno = 0;

    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify({ turno, lista: combatientes }));
      } catch {}
    };

    const pintarIniciativa = () => {
      const lista = $("ini-lista");
      if (!lista) return;
      combatientes.sort((a, b) => b.valor - a.valor);
      lista.innerHTML = combatientes
        .map(
          (c, i) =>
            `<li${i === turno ? ' class="activo"' : ""}><span>${c.nombre}</span><span class="num">${c.valor}</span></li>`,
        )
        .join("");
      guardar();
    };

    $("ini-anadir")?.addEventListener("click", () => {
      const nombre = ($("ini-nombre") as HTMLInputElement).value.trim() || "Sin nombre";
      const valor = Number(($("ini-valor") as HTMLInputElement).value) || 0;
      combatientes.push({ nombre, valor });
      ($("ini-nombre") as HTMLInputElement).value = "";
      turno = 0;
      pintarIniciativa();
    });

    $("ini-siguiente")?.addEventListener("click", () => {
      if (!combatientes.length) return;
      turno = (turno + 1) % combatientes.length;
      pintarIniciativa();
    });

    $("ini-proyectar")?.addEventListener("click", () => {
      guardar();
      window.open(`${BASE}/mesa/jugadores/`, "vista-jugador", "width=1100,height=760");
    });

    /* ----------------------------------------------------------------- dados */

    const d = (caras: number) => Math.floor(Math.random() * caras) + 1;
    $("dad-tirar")?.addEventListener("click", () => {
      const entrada = ($("dad-expresion") as HTMLInputElement).value.replace(/\s/g, "");
      const m = /^(\d*)d(\d+)([+-]\d+)?$/i.exec(entrada);
      const salida = $("dad-salida");
      if (!salida) return;
      if (!m) {
        salida.textContent = "Formato: 2d6+3";
        return;
      }
      const n = Number(m[1] || 1);
      const caras = Number(m[2]);
      const mod = Number(m[3] || 0);
      if (n > 100 || caras > 1000) {
        salida.textContent = "Demasiados dados.";
        return;
      }
      const tiradas = Array.from({ length: n }, () => d(caras));
      let total = tiradas.reduce((a, b) => a + b, 0) + mod;
      let extra = "";
      if (($("dad-ventaja") as HTMLInputElement).checked && n === 1 && caras === 20) {
        const otra = d(20);
        total = Math.max(tiradas[0], otra) + mod;
        extra = ` (la otra: ${Math.min(tiradas[0], otra)})`;
      }
      salida.innerHTML = `<strong>${total}</strong> = [${tiradas.join(", ")}]${
        mod ? ` ${mod > 0 ? "+" : "−"} ${Math.abs(mod)}` : ""
      }${extra}`;
    });

    /* ------------------------------------------------------------------- PNJ */

    const NOMBRES = ["Aldara", "Brumo", "Cassia", "Doran", "Elva", "Fermín", "Greta", "Hugo", "Isolda", "Jaro", "Kelia", "Lupo", "Mara", "Néstor", "Olga", "Pietro", "Quina", "Ramiro", "Sela", "Tobías", "Úrsula", "Vasco", "Wenda", "Ximena", "Yago", "Zoe"];
    const OFICIOS = ["herrero", "tabernero", "curandera", "guardia", "cartógrafo", "contrabandista", "escribano", "cazador", "barquero", "sepulturero", "juglar", "boticaria", "armero", "molinero", "sastre", "lacayo"];
    const MANIAS = ["no mira a los ojos cuando miente", "habla siempre en susurros", "cobra por adelantado y sin excepciones", "tiene un cuervo que repite lo que oye", "desconfía de cualquiera con espada", "recuerda todas las deudas, hasta las de cobre", "se ríe en el momento menos oportuno", "lleva guantes incluso en verano", "jura que vio algo en el bosque", "no bebe nada que no sirva él mismo"];

    $("pnj-generar")?.addEventListener("click", () => {
      const s = $("pnj-salida");
      if (s) s.innerHTML = `<strong>${azar(NOMBRES)}</strong>, ${azar(OFICIOS)}. Se rumorea que ${azar(MANIAS)}.`;
    });

    /* ----------------------------------------------------------------- botín */

    $("bot-generar")?.addEventListener("click", () => {
      const datos: Record<string, string[]> = JSON.parse($("datos-botin")?.textContent || "{}");
      const rareza = ($("bot-rareza") as HTMLSelectElement).value;
      const lista = datos[rareza] || [];
      const s = $("bot-salida");
      if (s)
        s.innerHTML = `<strong>${Math.floor(Math.random() * 20) + 1} po</strong> y <strong>${
          Math.floor(Math.random() * 100) + 1
        } pp</strong>; además, <em>${lista.length ? azar(lista) : "un objeto sin identificar"}</em>.`;
    });
  </script>
