---
import Base from "../../../layouts/Base.astro";
import MesaNav from "../../../components/MesaNav.astro";
import { cargar, EDICIONES } from "../../../lib/content";
import { panelesDe, fueraDePantalla } from "../../../lib/pantalla";
import { e } from "../../../lib/urls";

// La lista de paneles vive en `src/lib/pantalla.ts`, que la resuelve contra el
// catálogo y lanza si una regla se queda sin panel. Aquí no se filtra nada.
const reglas = cargar("5.5", "reglas");
const paneles = panelesDe(reglas);
const fuera = fueraDePantalla(reglas);
const publicadas = paneles.reduce((n, p) => n + p.entradas.length, 0);
const edicion = EDICIONES["5.5"];

const extracto = (texto: string) => {
  const limpio = texto
    .replace(/^#+\s.*$/gm, "")
    .replace(/\*\*|__|\*|_/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return limpio.length > 260 ? `${limpio.slice(0, 260).trimEnd()}…` : limpio;
};
---

<Base
  title="Pantalla del DM"
  description="Combate, condiciones, pruebas, daño, descanso, exploración y peligros del SRD 5.2.1 en una sola pantalla configurable e imprimible."
  ancho
>
  <header class="cabecera noprint">
    <div>
      <h1>Pantalla del DM</h1>
      <p class="cabecera__lede">
        Lo que se consulta en mitad de la partida, en una pantalla. Elige qué paneles quieres y la
        elección se recuerda en este navegador.
      </p>
      <p class="cabecera__meta">
        Publica {publicadas} de las {reglas.length} reglas del {edicion.srd} en {paneles.length} paneles;
        las {fuera.length} que faltan son el glosario completo, en el
        <a href={e("/5.5/reglas/indice/")}>índice de reglas</a>.
      </p>
    </div>
    <div class="cabecera__meta">
      <button class="btn btn--acento" type="button" onclick="window.print()">Imprimir</button>
    </div>
  </header>

  <MesaNav />

  <div class="pantalla-config noprint" id="config" role="group" aria-label="Paneles visibles">
    {paneles.map((p) => (
      <label class="pantalla-config__op">
        <input type="checkbox" data-panel={p.id} checked />
        <span>{p.titulo}</span>
      </label>
    ))}
  </div>

  <div class="pantalla" data-publicadas={publicadas} data-total={reglas.length}>
    {paneles.map((p) => (
      <section class="pantalla__panel" data-panel={p.id} aria-labelledby={`p-${p.id}`}>
        <h2 id={`p-${p.id}`}>{p.titulo}</h2>
        <dl class="pantalla__lista">
          {p.entradas.map((r) => (
            <div>
              <dt>
                <a href={e(`/5.5/reglas/${r.slug}/`)}>{r.data.name}</a>
              </dt>
              <dd>{extracto(r.body)}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>

  <p class="muted noprint" style="margin-top:1.5rem">
    Texto del {edicion.srd} ({edicion.nota.toLowerCase()}): {publicadas} de las {reglas.length} reglas,
    las {fuera.length} restantes en el
    <a href={e("/5.5/reglas/indice/")}>índice de reglas de {edicion.srd}</a>. La sección Mesa usa este
    catálogo; las reglas de 5.1 tienen su propio índice.
  </p>

  <script>
    import { guardarEnAlmacen, leerDeAlmacen } from "../../../lib/pantalla";

    const casillas = [...document.querySelectorAll<HTMLInputElement>("#config input[data-panel]")];
    const paneles = [...document.querySelectorAll<HTMLElement>(".pantalla [data-panel]")];
    const ids = casillas.map((c) => c.dataset.panel!);

    // `localStorage` puede no existir o no dejarse ni mirar (modo restringido).
    let almacen: Storage | null = null;
    try {
      almacen = window.localStorage;
    } catch {}

    // Qué se ve lo decide `leerDeAlmacen`: la página no interpreta la lista
    // guardada, solo asigna. Un panel que la elección no menciona se ve.
    const { visibles } = leerDeAlmacen(almacen, ids);
    for (const c of casillas) c.checked = visibles.includes(c.dataset.panel!);

    const aplicar = () => {
      const marcados = casillas.filter((c) => c.checked).map((c) => c.dataset.panel!);
      for (const p of paneles) p.hidden = !marcados.includes(p.dataset.panel!);
      // Se guardan los nueve ids con su estado: lo que no conste apagado, se ve.
      guardarEnAlmacen(almacen, ids, marcados);
    };

    for (const c of casillas) c.addEventListener("change", aplicar);
    aplicar();
  </script>
</Base>
