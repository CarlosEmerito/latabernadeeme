---
import Base from "../../../layouts/Base.astro";
import Detalle from "../../../components/Detalle.astro";
import { EDICIONES, TIPO_META, cargar, type Edition, type Tipo, TIPOS } from "../../../lib/content";
import { emparejar, parDe } from "../../../lib/emparejar";
import { e } from "../../../lib/urls";
import { imagenDe } from "../../../lib/imagenes";

export function getStaticPaths() {
  const rutas: { params: { ed: string; tipo: string; slug: string } }[] = [];
  for (const ed of ["5e", "5.5"] as Edition[]) {
    for (const tipo of TIPOS) {
      for (const en of cargar(ed, tipo)) rutas.push({ params: { ed, tipo, slug: en.slug } });
    }
  }
  return rutas;
}

const ed = Astro.params.ed as Edition;
const tipo = Astro.params.tipo as Tipo;
const slug = Astro.params.slug!;
const entradas = cargar(ed, tipo);
const indice = entradas.findIndex((x) => x.slug === slug);
const entrada = entradas[indice];

if (!entrada) return Astro.redirect(e("/404/"));

const otra: Edition = ed === "5e" ? "5.5" : "5e";
// La contraparte es la entrada de la otra edición que es el **mismo objeto**,
// no la que comparte identificador: en el equipo del 5.2.1 el orden de las
// filas de la tabla cambió y los dos ficheros de la «Vara» se renumeraron, así
// que el identificador `vara` es la varita en el 5.1 y la pértiga en el 5.2.1.
// Con el identificador, la ficha de la varita en el 5.2.1 no ofrecía su
// versión de 2014 y la de la pértiga no ofrecía la de 2024.
const par = parDe(emparejar(cargar("5e", tipo), cargar("5.5", tipo)), slug, ed === "5e" ? "a" : "b");
const contraparte = par ? (ed === "5e" ? par.b : par.a) : undefined;
const otraEdicion = contraparte
  ? { ed: otra, srd: EDICIONES[otra].srd, slug: contraparte.slug }
  : undefined;

const meta = EDICIONES[ed];
const t = TIPO_META[tipo];
const titulo = String(entrada.data.name);
// La sección va en el título y en la descripción: «Escudo» es un conjuro y un
// escudo de equipo, y las dos fichas se anunciaban igual.
const seccion = t.singular.toLowerCase();
const descripcion =
  tipo === "monstruos"
    ? `${titulo}, VD ${entrada.data.cr} (${meta.srd}).`
    : tipo === "conjuros"
      ? `${titulo}, ${entrada.data.level === 0 ? "truco" : `conjuro de nivel ${entrada.data.level}`} de ${entrada.data.school} (${meta.srd}).`
      : `${titulo}, ${seccion} (${meta.srd}).`;
const sigilo = imagenDe(tipo, slug, titulo).src;
---

<Base title={titulo} description={descripcion} edicion={ed} tipo={tipo} seccion={t.singular} imagen={sigilo} tipoOg="article">
  <nav class="migas" aria-label="Migas de pan">
    <a href={e(`/${ed}/`)}>{meta.srd}</a>
    <span aria-hidden="true">/</span>
    <a href={e(`/${ed}/${tipo}/`)}>{t.plural}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{titulo}</span>
  </nav>

  <Detalle
    entrada={entrada}
    edicion={ed}
    tipo={tipo}
    anterior={indice > 0 ? entradas[indice - 1] : undefined}
    siguiente={indice < entradas.length - 1 ? entradas[indice + 1] : undefined}
    otraEdicion={otraEdicion}
  />
</Base>
