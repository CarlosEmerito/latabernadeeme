---
import { plegar } from "../lib/texto";

interface Faceta {
  clave: string;
  etiqueta: string;
  tipo?: "lista" | "rango";
  valores?: { valor: string; texto: string }[];
  min?: number;
  max?: number;
  paso?: number;
}

interface Columna {
  clave: string;
  etiqueta: string;
  tipo?: "num" | "texto";
  ocultoMovil?: boolean;
}

interface Fila {
  href: string;
  nombre: string;
  /**
   * Nombre inglés de la ficha, cuando lo tiene (`aliasDe`). Va en `data-buscar`
   * detrás del español: la ficha publica «En inglés: …» y el buscador del sitio
   * lo encuentra, así que el filtro del listado no puede dejarlo fuera.
   */
  alias?: string;
  chips?: string[];
  celdas: Record<string, string | number>;
  facetas: Record<string, string>;
  rangos?: Record<string, number>;
}

interface Props {
  columnas: Columna[];
  filas: Fila[];
  facetas: Faceta[];
  buscador?: boolean;
  placeholder?: string;
  vacio?: string;
  nota?: string;
}

const {
  columnas,
  filas,
  facetas,
  buscador = true,
  placeholder = "Filtrar por nombre…",
  vacio = "No hay nada con esos filtros.",
  nota,
} = Astro.props;

// La primera columna de la tabla es siempre el nombre: es la celda que enlaza a
// la ficha. Se antepone aquí, en un único sitio, en vez de repetirla en las
// nueve listas de columnas de cada tipo; si se declarara allí, su valor real
// (VD, nivel, tipo…) seguiría sin celda propia.
const COLUMNA_NOMBRE: Columna = { clave: "__nombre", etiqueta: "Nombre" };
const columnasTabla: Columna[] = [COLUMNA_NOMBRE, ...columnas];

/**
 * El texto con el que el filtro compara una fila.
 *
 * El nombre en español va delante —así el atributo sigue sirviendo para lo de
 * antes y para las comprobaciones que lo leen— y detrás, cuando existe y no
 * repite el español, el nombre inglés. Sin él, quien conoce la entrada como
 * «Thunderwave» se encuentra el listado en cero al lado de una ficha que sí lo
 * llama así.
 */
const buscable = (f: Fila): string => {
  const nombre = plegar(f.nombre);
  const alias = f.alias ? plegar(f.alias) : "";
  return alias && alias !== nombre ? `${nombre} ${alias}` : nombre;
};

// Recuento por valor, para que el menú diga cuántas hay antes de filtrar.
const cuentaValor = (clave: string, valor: string) =>
  filas.filter((f) =>
    String(f.facetas[clave] ?? "")
      .toLowerCase()
      .split("|")
      .includes(valor.toLowerCase()),
  ).length;
---

<form class="toolbar" role="search" id="filtros" aria-label="Filtrar y ordenar">
  {buscador && (
    <label class="campo campo--texto">
      <span class="oculto-visual">Buscar</span>
      <input type="search" id="f-texto" data-buscar placeholder={placeholder} autocomplete="off" />
    </label>
  )}

  {facetas.map((f) =>
    f.tipo === "rango" ? (
      <div class="campo campo--rango">
        <span class="campo__etiqueta" id={`et-${f.clave}`}>{f.etiqueta}</span>
        <div class="rango" role="group" aria-labelledby={`et-${f.clave}`}>
          <input
            type="number"
            inputmode="numeric"
            id={`f-${f.clave}-min`}
            data-rango-min={f.clave}
            min={f.min}
            max={f.max}
            step={f.paso ?? 1}
            placeholder={String(f.min ?? "")}
            aria-label={`${f.etiqueta}: mínimo`}
          />
          <span aria-hidden="true">–</span>
          <input
            type="number"
            inputmode="numeric"
            id={`f-${f.clave}-max`}
            data-rango-max={f.clave}
            min={f.min}
            max={f.max}
            step={f.paso ?? 1}
            placeholder={String(f.max ?? "")}
            aria-label={`${f.etiqueta}: máximo`}
          />
        </div>
      </div>
    ) : (
      <details class="campo campo--faceta" data-clave={f.clave}>
        <summary>
          <span class="campo__etiqueta">{f.etiqueta}</span>
          <span class="faceta__sel" data-sel aria-hidden="true"></span>
        </summary>
        <div class="faceta__menu">
          {(f.valores ?? []).map((v) => {
            const n = cuentaValor(f.clave, v.valor);
            return (
              <label class="faceta__op">
                <input type="checkbox" value={v.valor} data-faceta={f.clave} disabled={n === 0} />
                <span class="faceta__texto">{v.texto}</span>
                <span class="faceta__n num">{n}</span>
              </label>
            );
          })}
        </div>
      </details>
    ),
  )}

  <button class="btn btn--fantasma" type="button" id="limpiar">Limpiar</button>
  <p class="cuenta" id="cuenta" aria-live="polite">{filas.length} entradas</p>
</form>

{nota && <p class="toolbar__nota muted">{nota}</p>}

<div class="panel-tabla">
  <table class="tabla" id="tabla">
    <thead>
      <tr>
        {columnasTabla.map((c) => (
          <th
            scope="col"
            class:list={[c.tipo === "num" && "col-num", c.ocultoMovil && "oculto-movil"]}
            data-orden={c.clave}
            data-tipo={c.tipo ?? "texto"}
            aria-sort="none"
          >
            <button type="button">{c.etiqueta}</button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody id="cuerpo">
      {filas.map((f) => (
        <tr
          data-facetas={JSON.stringify(f.facetas)}
          data-rangos={JSON.stringify(f.rangos ?? {})}
          data-buscar={buscable(f)}
        >
          <td class="col-nombre">
            <a href={f.href}>{f.nombre}</a>
          </td>
          {columnas.map((c) => (
            <td class:list={[c.tipo === "num" && "col-num", c.ocultoMovil && "oculto-movil"]}>
              {String(f.celdas[c.clave] ?? "")}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p id="sin-resultados" class="muted" hidden>{vacio}</p>

<script>
  import { plegar } from "../lib/texto";
  import { valorDeOrden } from "../lib/medidas";

  const form = document.getElementById("filtros") as HTMLFormElement | null;
  const tabla = document.getElementById("tabla") as HTMLTableElement | null;
  const cuerpo = document.getElementById("cuerpo");
  const cuenta = document.getElementById("cuenta");
  const sinResultados = document.getElementById("sin-resultados");
  const texto = document.getElementById("f-texto") as HTMLInputElement | null;

  if (form && tabla && cuerpo) {
    const filas = Array.from(cuerpo.querySelectorAll<HTMLTableRowElement>("tr"));
    const casillas = Array.from(form.querySelectorAll<HTMLInputElement>("[data-faceta]"));
    const rangos = Array.from(form.querySelectorAll<HTMLInputElement>("[data-rango-min], [data-rango-max]"));

    const leerURL = () => {
      const p = new URLSearchParams(location.search);
      if (texto && p.get("q")) texto.value = p.get("q")!;
      for (const casilla of casillas) {
        const clave = casilla.dataset.faceta!;
        const valores = (p.get(clave) ?? "").split(",").filter(Boolean).map((v) => v.toLowerCase());
        casilla.checked = valores.includes(casilla.value.toLowerCase());
      }
      for (const input of rangos) {
        const clave = input.dataset.rangoMin ?? input.dataset.rangoMax!;
        const rango = (p.get(clave) ?? "").split("-");
        if (!rango.length) continue;
        if (input.dataset.rangoMin && rango[0]) input.value = rango[0];
        if (input.dataset.rangoMax && rango[1]) input.value = rango[1];
      }
    };

    const estado = () => {
      const facetas = new Map<string, Set<string>>();
      for (const casilla of casillas) {
        if (!casilla.checked) continue;
        const clave = casilla.dataset.faceta!;
        if (!facetas.has(clave)) facetas.set(clave, new Set());
        facetas.get(clave)!.add(casilla.value.toLowerCase());
      }
      const rangosActivos = new Map<string, [number, number]>();
      for (const input of rangos) {
        const clave = input.dataset.rangoMin ?? input.dataset.rangoMax!;
        const actual = rangosActivos.get(clave) ?? [Number.NEGATIVE_INFINITY, Number.POSITIVE_INFINITY];
        const v = input.value.trim() === "" ? undefined : Number(input.value);
        if (v !== undefined && !Number.isNaN(v)) {
          if (input.dataset.rangoMin) actual[0] = v;
          else actual[1] = v;
        }
        rangosActivos.set(clave, actual);
      }
      // La consulta se pliega igual que `data-buscar`: si no, «dragón» (con
      // tilde) no encontraría «Dragón» y «dragon» no encontraría nada.
      return { facetas, rangosActivos, q: plegar((texto?.value ?? "").trim()) };
    };

    const escribirURL = (e: ReturnType<typeof estado>) => {
      const p = new URLSearchParams();
      if (e.q) p.set("q", e.q);
      for (const [clave, valores] of e.facetas) if (valores.size) p.set(clave, [...valores].join(","));
      for (const [clave, [min, max]] of e.rangosActivos) {
        if (min !== Number.NEGATIVE_INFINITY || max !== Number.POSITIVE_INFINITY) {
          const a = min === Number.NEGATIVE_INFINITY ? "" : String(min);
          const b = max === Number.POSITIVE_INFINITY ? "" : String(max);
          p.set(clave, `${a}-${b}`);
        }
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
      for (const detalle of form.querySelectorAll<HTMLDetailsElement>("details.campo--faceta")) {
        const clave = detalle.dataset.clave!;
        const n = e.facetas.get(clave)?.size ?? 0;
        const sello = detalle.querySelector<HTMLElement>("[data-sel]")!;
        sello.textContent = n ? String(n) : "";
        detalle.classList.toggle("activa", n > 0);
      }
    };

    const aplicar = () => {
      const e = estado();
      let visibles = 0;
      for (const fila of filas) {
        const facetas = JSON.parse(fila.dataset.facetas || "{}") as Record<string, string>;
        const nums = JSON.parse(fila.dataset.rangos || "{}") as Record<string, number>;
        const nombre = fila.dataset.buscar || "";
        let cumple = !e.q || nombre.includes(e.q);

        if (cumple) {
          for (const [clave, valores] of e.facetas) {
            const propios = String(facetas[clave] ?? "").toLowerCase().split("|");
            if (![...valores].some((v) => propios.includes(v))) {
              cumple = false;
              break;
            }
          }
        }
        if (cumple) {
          for (const [clave, [min, max]] of e.rangosActivos) {
            const v = nums[clave];
            if (v === undefined || v < min || v > max) {
              cumple = false;
              break;
            }
          }
        }
        fila.hidden = !cumple;
        if (cumple) visibles++;
      }
      if (cuenta) cuenta.textContent = `${visibles} ${visibles === 1 ? "entrada" : "entradas"}`;
      if (sinResultados) sinResultados.hidden = visibles !== 0;
      escribirURL(e);
    };

    form.addEventListener("input", aplicar);
    form.addEventListener("change", aplicar);
    form.addEventListener("submit", (ev) => ev.preventDefault());
    document.getElementById("limpiar")?.addEventListener("click", () => {
      form.reset();
      if (texto) texto.value = "";
      for (const d of form.querySelectorAll<HTMLDetailsElement>("details")) d.open = false;
      aplicar();
    });

    // Orden por columna. El valor que se compara sale de `medidas.ts`: Precio
    // mezcla monedas y Peso mezcla kilos con gramos, así que se convierten a una
    // unidad común antes de comparar; el resto de columnas se leen tal cual.
    const cabeceras = Array.from(tabla.querySelectorAll<HTMLTableCellElement>("th[data-orden]"));
    for (const th of cabeceras) {
      th.addEventListener("click", () => {
        const esNum = th.dataset.tipo === "num";
        const nuevoAsc = th.getAttribute("aria-sort") !== "ascending";
        cabeceras.forEach((h) => h.setAttribute("aria-sort", "none"));
        th.setAttribute("aria-sort", nuevoAsc ? "ascending" : "descending");
        const indice = cabeceras.indexOf(th);
        const ordenadas = [...filas].sort((a, b) => {
          const va = a.children[indice]?.textContent?.trim() ?? "";
          const vb = b.children[indice]?.textContent?.trim() ?? "";
          if (esNum) {
            const clave = th.dataset.orden ?? "";
            const na = valorDeOrden(clave, va);
            const nb = valorDeOrden(clave, vb);
            return nuevoAsc ? na - nb : nb - na;
          }
          return nuevoAsc ? va.localeCompare(vb, "es") : vb.localeCompare(va, "es");
        });
        ordenadas.forEach((f) => cuerpo.appendChild(f));
      });
    }

    leerURL();
    aplicar();
  }
</script>
