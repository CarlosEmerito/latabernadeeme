---
import Base from "../../../layouts/Base.astro";
import MesaNav from "../../../components/MesaNav.astro";
import { e } from "../../../lib/urls";
---

<Base title="Iniciativa · vista de jugador" description="Orden de iniciativa para proyectar en la mesa." ancho>
  <header class="cabecera">
    <div>
      <h1>Iniciativa</h1>
      <p class="cabecera__lede">
        Esta ventana se actualiza sola cuando cambia el orden en la página de mesa. Déjala abierta
        en la pantalla de los jugadores.
      </p>
    </div>
  </header>

  <MesaNav />

  <div class="jugadores" id="jugadores" aria-live="polite">
    <p class="jugadores__turno" id="turno">Sin combate</p>
    <ol class="jugadores__lista" id="lista"></ol>
  </div>

  <p class="muted" style="margin-top:2rem">
    <a href={e("/mesa/")}>Volver a la mesa</a>
  </p>

  <script>
    import { CLAVE_INICIATIVA, leerIniciativa } from "../../../lib/iniciativa";

    const pintar = () => {
      const turno = document.getElementById("turno");
      const lista = document.getElementById("lista");
      if (!turno || !lista) return;

      let crudo: string | null = null;
      try {
        crudo = localStorage.getItem(CLAVE_INICIATIVA);
      } catch {}

      const estado = leerIniciativa(crudo);
      if (!estado) {
        turno.textContent = "Sin combate";
        lista.replaceChildren();
        return;
      }

      const activo = document.createElement("strong");
      activo.textContent = estado.lista[estado.turno].nombre;
      turno.replaceChildren("Turno de ", activo);
      lista.replaceChildren(
        ...estado.lista.map((c, i) => {
          const fila = document.createElement("li");
          if (i === estado.turno) fila.className = "activo";
          const nombre = document.createElement("span");
          nombre.textContent = c.nombre;
          const valor = document.createElement("span");
          valor.className = "num";
          valor.textContent = String(c.valor);
          fila.append(nombre, valor);
          return fila;
        }),
      );
    };

    window.addEventListener("storage", (ev) => {
      if (ev.key === CLAVE_INICIATIVA) pintar();
    });
    pintar();
  </script>
</Base>
