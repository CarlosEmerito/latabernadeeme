{
  "name": "latabernadeeme",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "La Taberna de Eme: referencia y herramientas de mesa para la quinta edición de D&D y las reglas de 2024, construida sobre el SRD en español.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:sin-indice": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "datos": ".venv-ingest/bin/python tools/ingest/extract_core.py",
    "datos:reglas": ".venv-ingest/bin/python tools/ingest/import_rules.py",
    "datos:pdf": ".venv-ingest/bin/python tools/ingest/descargar.py",
    "datos:flujo": ".venv-ingest/bin/python tools/ingest/pdf_stream.py",
    "verificar": ".venv-ingest/bin/python tools/verify/validar.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^7.4.1",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
