---
interface Faceta {
  clave: string;
  etiqueta: string;
  valores: { valor: string; texto: string }[];
}

interface Item {
  slug: string;
  nombre: string;
  meta: string;
  texto: string;
  facetas: Record<string, string>;
}

interface Props {
  base: string;
  items: Item[];
  facetas: Faceta[];
  buscador?: boolean;
  vacio?: string;
}

const { base, items, facetas, buscador = true, vacio = "No hay resultados con esos filtros." } = Astro.props;
---

<form class="filtros" role="search" aria-label="Filtrar" id="filtros">
  {buscador && (
    <label class="campo campo--ancho">
      <span>Buscar</span>
      <input type="search" data-faceta="texto" placeholder="Nombre o texto…" autocomplete="off" />
    </label>
  )}
  {facetas.map((f) => (
    <label class="campo">
      <span>{f.etiqueta}</span>
      <select data-faceta={f.clave}>
        <option value="">Todas</option>
        {f.valores.map((v) => (
          <option value={v.valor}>{v.texto}</option>
        ))}
      </select>
    </label>
  ))}
  <button class="btn" type="reset" id="limpiar-filtros">Limpiar</button>
  <p class="contador" id="contador" aria-live="polite">{items.length} entradas</p>
</form>

<div class="rejilla" id="rejilla">
  {items.map((i) => (
    <a
      class="tarjeta"
      href={`${base}/${i.slug}/`}
      data-buscar={i.nombre.toLowerCase()}
      data-facetas={JSON.stringify(i.facetas)}
    >
      <span class="tarjeta__nombre">{i.nombre}</span>
      <span class="tarjeta__meta">{i.meta}</span>
      {i.texto && <span class="tarjeta__texto">{i.texto}</span>}
    </a>
  ))}
</div>

<p id="sin-resultados" hidden>{vacio}</p>

<script>
  const form = document.getElementById("filtros") as HTMLFormElement | null;
  const rejilla = document.getElementById("rejilla");
  const contador = document.getElementById("contador");
  const vacio = document.getElementById("sin-resultados");
  if (form && rejilla) {
    const tarjetas = Array.from(rejilla.querySelectorAll<HTMLAnchorElement>(".tarjeta"));

    const aplicar = () => {
      const campos = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-faceta]"));
      const activos = campos
        .map((c) => ({ clave: c.dataset.faceta!, valor: c.value.trim().toLowerCase() }))
        .filter((f) => f.valor);
      let visibles = 0;
      for (const t of tarjetas) {
        const facetas = JSON.parse(t.dataset.facetas || "{}") as Record<string, string>;
        const texto = t.dataset.buscar || "";
        const cumple = activos.every((f) => {
          if (f.clave === "texto") {
            return texto.includes(f.valor) || t.textContent!.toLowerCase().includes(f.valor);
          }
          return String(facetas[f.clave] ?? "").toLowerCase() === f.valor;
        });
        t.hidden = !cumple;
        if (cumple) visibles++;
      }
      if (contador) contador.textContent = `${visibles} ${visibles === 1 ? "entrada" : "entradas"}`;
      if (vacio) vacio.hidden = visibles !== 0;
    };

    form.addEventListener("input", aplicar);
    form.addEventListener("change", aplicar);
    form.addEventListener("reset", () => setTimeout(aplicar, 0));
  }
</script>
